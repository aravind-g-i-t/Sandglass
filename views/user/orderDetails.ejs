<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Order Details</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --purple-50:  #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50:  #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #1D9E75;
            --success-bg: #E8F8F2;
            --warning: #D97706;
            --warning-bg: #FEF3C7;
        }

        .header-area { display: none !important; }

        html, body {
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
            background: var(--gray-50);
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1050;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px; height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px; color: var(--gray-900);
        }

        .sg-search {
            position: relative; flex: 0 0 220px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px; font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200); border-radius: 8px;
            background: var(--gray-50); color: var(--gray-900);
            outline: none; transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder { color: var(--gray-200); }

        .sg-search-icon {
            position: absolute; left: 10px; top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400); pointer-events: none;
        }

        .sg-header-actions { display: flex; align-items: center; gap: 8px; }

        .sg-icon-btn {
            width: 38px; height: 38px; border-radius: 8px;
            border: 1px solid var(--gray-100); background: var(--white);
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; color: var(--gray-600); position: relative;
            transition: background 0.15s;
        }

        .sg-icon-btn:hover { background: var(--gray-50); color: var(--gray-900); }

        .sg-badge {
            position: absolute; top: -5px; right: -5px;
            width: 18px; height: 18px;
            background: var(--purple-800); color: #fff;
            border-radius: 50%; font-size: 10px; font-weight: 500;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-user-wrap { position: relative; }

        .sg-user-btn {
            display: flex; align-items: center; gap: 8px;
            padding: 6px 12px; border: 1px solid var(--gray-100);
            border-radius: 8px; background: var(--white);
            font-size: 13px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            color: var(--gray-900); text-decoration: none; transition: background 0.15s;
        }

        .sg-user-btn:hover { background: var(--gray-50); color: var(--gray-900); }

        .sg-user-avatar {
            width: 26px; height: 26px; border-radius: 50%;
            background: var(--purple-100);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 600; color: var(--purple-800);
        }

        .sg-dropdown {
            position: absolute; right: 0; top: calc(100% + 8px);
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 12px; padding: 6px; min-width: 180px;
            box-shadow: 0 8px 24px rgba(60,52,137,0.10);
            display: none; z-index: 200;
        }

        .sg-user-wrap:hover .sg-dropdown { display: block; }

        .sg-dropdown a {
            display: flex; align-items: center; gap: 8px;
            padding: 9px 12px; font-size: 13px; color: var(--gray-900);
            text-decoration: none; border-radius: 8px; transition: background 0.12s;
        }

        .sg-dropdown a:hover { background: var(--gray-50); }
        .sg-dropdown a.danger { color: var(--danger); }
        .sg-dropdown a.danger:hover { background: var(--danger-bg); }
        .sg-dropdown-divider { height: 1px; background: var(--gray-100); margin: 4px 0; }

        /* ── Navbar ── */
        .sg-navbar {
            position: fixed; top: 64px; left: 0; right: 0; z-index: 1040;
            background: var(--purple-900);
            display: flex; align-items: center; justify-content: center;
            gap: 40px; padding: 0 48px; height: 46px;
        }

        .sg-navbar a {
            font-size: 13px; font-weight: 500;
            color: rgba(255,255,255,0.75); text-decoration: none; transition: color 0.15s;
        }

        .sg-navbar a:hover, .sg-navbar a.active { color: #fff; }

        /* ── Page offset ── */
        .sg-offset { padding-top: 110px; }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            background: var(--white); border-bottom: 1px solid var(--gray-100);
            padding: 14px 0; font-size: 13px; color: var(--gray-400);
        }

        .sg-breadcrumb .container { display: flex; align-items: center; gap: 8px; }
        .sg-breadcrumb a { color: var(--purple-600); text-decoration: none; font-weight: 500; }
        .sg-breadcrumb a:hover { text-decoration: underline; }
        .sg-breadcrumb .bc-sep { color: var(--gray-200); }
        .sg-breadcrumb .bc-current { color: var(--gray-900); font-weight: 500; }

        /* ── Page layout ── */
        .sg-page { padding: 40px 0 64px; }

        /* ── Page title row ── */
        .sg-page-title-row {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 28px; flex-wrap: wrap; gap: 12px;
        }

        .sg-page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px; font-weight: 400; color: var(--gray-900);
        }

        .sg-order-meta {
            font-size: 13px; color: var(--gray-400); margin-top: 4px;
        }

        .sg-order-id {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px;
            background: var(--purple-50); border: 1px solid var(--purple-100);
            border-radius: 8px; font-size: 12px; font-weight: 500; color: var(--purple-800);
        }

        /* ── Info cards row ── */
        .sg-info-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
            margin-bottom: 24px;
        }

        .sg-info-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; padding: 20px 22px;
            display: flex; gap: 14px; align-items: flex-start;
        }

        .sg-info-icon {
            width: 40px; height: 40px; border-radius: 10px;
            background: var(--purple-50); border: 1px solid var(--purple-100);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; color: var(--purple-600);
        }

        .sg-info-label {
            font-size: 11px; font-weight: 500; letter-spacing: 0.08em;
            text-transform: uppercase; color: var(--gray-400); margin-bottom: 6px;
        }

        .sg-info-value {
            font-size: 13px; color: var(--gray-600); line-height: 1.65;
        }

        .sg-info-value strong { color: var(--gray-900); font-weight: 500; }

        .sg-info-link {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 12px; font-weight: 500; color: var(--purple-600);
            text-decoration: none; margin-top: 8px;
        }

        .sg-info-link:hover { text-decoration: underline; }

        /* ── Products table card ── */
        .sg-table-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; overflow: hidden; margin-bottom: 24px;
        }

        .sg-table-card-header {
            padding: 18px 24px; border-bottom: 1px solid var(--gray-100);
            font-size: 15px; font-weight: 500; color: var(--gray-900);
            display: flex; align-items: center; gap: 8px;
        }

        .sg-table {
            width: 100%; border-collapse: collapse; font-size: 14px;
        }

        .sg-table thead { background: var(--gray-50); border-bottom: 1px solid var(--gray-100); }

        .sg-table thead th {
            padding: 12px 20px;
            font-size: 11px; font-weight: 500; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--gray-400); text-align: left;
        }

        .sg-table thead th.text-right { text-align: right; }

        .sg-table tbody tr { border-bottom: 1px solid var(--gray-100); transition: background 0.12s; }
        .sg-table tbody tr:last-child { border-bottom: none; }
        .sg-table tbody tr:hover { background: var(--gray-50); }

        .sg-table tbody td { padding: 16px 20px; vertical-align: middle; }
        .sg-table tbody td.text-right { text-align: right; }

        .sg-product-cell { display: flex; align-items: center; gap: 12px; }

        .sg-product-thumb {
            width: 52px; height: 52px; border-radius: 10px;
            object-fit: cover; border: 1px solid var(--gray-100); flex-shrink: 0;
        }

        .sg-product-cell-name {
            font-size: 14px; font-weight: 500; color: var(--gray-900);
            max-width: 220px; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis;
        }

        /* Status badges */
        .sg-status {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px; border-radius: 20px;
            font-size: 12px; font-weight: 500;
        }

        .sg-status.delivered   { background: var(--success-bg); color: var(--success); border: 1px solid #9FE1CB; }
        .sg-status.cancelled   { background: var(--danger-bg);  color: var(--danger);  border: 1px solid #F7C1C1; }
        .sg-status.pending     { background: var(--warning-bg); color: var(--warning); border: 1px solid #FCD34D; }
        .sg-status.shipped     { background: var(--purple-50);  color: var(--purple-800); border: 1px solid var(--purple-100); }
        .sg-status.processing  { background: var(--purple-50);  color: var(--purple-800); border: 1px solid var(--purple-100); }

        /* ── Summary card ── */
        .sg-summary-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; overflow: hidden;
        }

        .sg-summary-header {
            padding: 18px 24px; border-bottom: 1px solid var(--gray-100);
            font-size: 15px; font-weight: 500; color: var(--gray-900);
            display: flex; align-items: center; gap: 8px;
        }

        .sg-summary-body { padding: 20px 24px; }

        .sg-summary-row {
            display: flex; justify-content: space-between;
            align-items: center; font-size: 14px; color: var(--gray-600);
            padding: 8px 0;
        }

        .sg-summary-row.discount { color: var(--success); }
        .sg-summary-divider { height: 1px; background: var(--gray-100); margin: 8px 0; }

        .sg-summary-total {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 0 0;
        }

        .sg-summary-total-label { font-size: 15px; font-weight: 500; color: var(--gray-900); }

        .sg-summary-total-price {
            font-family: 'DM Serif Display', serif;
            font-size: 26px; color: var(--purple-800);
        }

        .sg-payment-status-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 14px 0 0; margin-top: 4px;
            border-top: 1px solid var(--gray-100);
        }

        .sg-payment-status-label { font-size: 13px; color: var(--gray-400); }

        .sg-payment-badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px; border-radius: 20px;
            font-size: 12px; font-weight: 500;
            background: var(--success-bg); color: var(--success);
            border: 1px solid #9FE1CB;
        }

        /* ── Invoice button ── */
        .sg-btn-invoice {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 11px 20px;
            background: var(--purple-800); color: #fff;
            border: none; border-radius: 8px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            text-decoration: none; cursor: pointer;
            transition: background 0.15s;
            margin-top: 20px;
        }

        .sg-btn-invoice:hover { background: var(--purple-900); color: #fff; }

        /* ── Back link ── */
        .sg-back-link {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 13px; font-weight: 500; color: var(--purple-600);
            text-decoration: none; margin-bottom: 24px;
        }

        .sg-back-link:hover { text-decoration: underline; }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .sg-header-inner { padding: 0 20px; }
            .sg-search { display: none; }
            .sg-navbar { display: none; }
            .sg-offset { padding-top: 64px; }
            .sg-info-grid { grid-template-columns: 1fr; }
            .sg-page-title-row { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>

<body>

    <!-- ── Sandglass Header ── -->
    <header class="sg-header">
        <div class="sg-header-inner">
            <a href="/" class="sg-logo">
                <div class="sg-logo-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                    </svg>
                </div>
                <span class="sg-logo-text">Sandglass</span>
            </a>

            <div class="sg-search">
                <span class="sg-search-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </span>
                <form action="/shop" method="get">
                    <input name="search" type="text" placeholder="Search for items…">
                </form>
            </div>

            <div class="sg-header-actions">
                <% if(userData) { %>
                    <a href="/wishlist" class="sg-icon-btn" title="Wishlist">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        <span class="sg-badge">4</span>
                    </a>
                    <a href="/cart" class="sg-icon-btn" title="Cart">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        <span class="sg-badge">2</span>
                    </a>
                    <div class="sg-user-wrap">
                        <a href="#" class="sg-user-btn">
                            <div class="sg-user-avatar"><%= userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %></div>
                            <%= userData.username %>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </a>
                        <div class="sg-dropdown">
                            <a href="/profile">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profile
                            </a>
                            <div class="sg-dropdown-divider"></div>
                            <a href="#" id="logoutBtn" class="danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                                Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="sg-user-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Log in
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- ── Navbar ── -->
    <nav class="sg-navbar">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
    </nav>

    <div class="sg-offset"></div>

    <!-- ── Breadcrumb ── -->
    <div class="sg-breadcrumb">
        <div class="container">
            <a href="/">Home</a>
            <span class="bc-sep">›</span>
            <a href="/profile">Profile</a>
            <span class="bc-sep">›</span>
            <span class="bc-current">Order details</span>
        </div>
    </div>

    <main class="main">
        <div class="sg-page">
            <div class="container">

                <!-- Back link -->
                <a href="/profile" class="sg-back-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    Back to profile
                </a>

                <!-- Page title -->
                <div class="sg-page-title-row">
                    <div>
                        <h1 class="sg-page-title">Order details</h1>
                        <p class="sg-order-meta">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Wed, Aug 13, 2022, 4:34 PM
                        </p>
                    </div>
                    <div class="sg-order-id">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        Order #<%= orderData.orderId %>
                    </div>
                </div>

                <!-- ── Info cards ── -->
                <div class="sg-info-grid">

                    <!-- Customer -->
                    <div class="sg-info-card">
                        <div class="sg-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div>
                            <p class="sg-info-label">Customer</p>
                            <div class="sg-info-value">
                                <strong><%= orderData.userId.username %></strong><br>
                                <%= orderData.userId.email %><br>
                                <%= orderData.userId.phone %>
                            </div>
                            <a href="/profile" class="sg-info-link">
                                View profile
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Order info -->
                    <div class="sg-info-card">
                        <div class="sg-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        </div>
                        <div>
                            <p class="sg-info-label">Order info</p>
                            <div class="sg-info-value">
                                <strong>Shipping:</strong> Fargo Express<br>
                                <strong>Payment:</strong> <%= orderData.paymentMethod %>
                            </div>
                        </div>
                    </div>

                    <!-- Deliver to -->
                    <div class="sg-info-card">
                        <div class="sg-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                            <p class="sg-info-label">Deliver to</p>
                            <div class="sg-info-value">
                                <%= address.address[0].addressLine1 %>, <%= address.address[0].addressLine2 %><br>
                                <%= address.address[0].city %>, <%= address.address[0].state %><br>
                                <strong>PIN:</strong> <%= address.address[0].pincode %> &nbsp;·&nbsp; <strong>Ph:</strong> <%= address.address[0].phone %>
                            </div>
                            <a href="/profile?tab=address" class="sg-info-link">
                                View address
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- ── Products table ── -->
                <div class="sg-table-card">
                    <div class="sg-table-card-header">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--purple-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        Ordered items
                    </div>
                    <table class="sg-table">
                        <thead>
                            <tr>
                                <th style="width:40%">Product</th>
                                <th>Unit price</th>
                                <th>Qty</th>
                                <th class="text-right">Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orderData.products.forEach(product => { %>
                            <tr>
                                <td>
                                    <div class="sg-product-cell">
                                        <img src="/uploads/<%= product.productId.productImage[0] %>" alt="<%= product.productId.productName %>" class="sg-product-thumb">
                                        <span class="sg-product-cell-name"><%= product.productId.productName %></span>
                                    </div>
                                </td>
                                <td style="color:var(--gray-600)">₹<%= (product.productPrice * (1 - (couponDiscount / 100))).toFixed(2) %></td>
                                <td>
                                    <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;background:var(--gray-50);border:1px solid var(--gray-100);font-size:13px;font-weight:500">
                                        <%= product.quantity %>
                                    </span>
                                </td>
                                <td class="text-right" style="font-weight:500;color:var(--purple-800)">₹<%= (product.productPrice * product.quantity * (1 - (couponDiscount / 100))).toFixed(2) %></td>
                                <td>
                                    <%
                                        const s = product.status ? product.status.toLowerCase() : 'pending';
                                        const cls = ['delivered','cancelled','pending','shipped','processing'].includes(s) ? s : 'pending';
                                    %>
                                    <span class="sg-status <%= cls %>">
                                        <% if (cls === 'delivered') { %>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                        <% } else if (cls === 'cancelled') { %>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        <% } else { %>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <% } %>
                                        <%= product.status %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- ── Summary + Invoice row ── -->
                <div class="row justify-content-end">
                    <div class="col-lg-5 col-md-7">
                        <div class="sg-summary-card">
                            <div class="sg-summary-header">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--purple-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                                Price summary
                            </div>
                            <div class="sg-summary-body">
                                <div class="sg-summary-row">
                                    <span>Subtotal</span>
                                    <span>₹<%= totalPrice.toFixed(2) %></span>
                                </div>

                                <% if (orderData.coupon) { %>
                                <div class="sg-summary-row discount">
                                    <span>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-1px"><polyline points="20 6 9 17 4 12"/></svg>
                                        Coupon (<%= orderData.coupon %>)
                                    </span>
                                    <span>−₹<%= (totalPrice * (couponDiscount / 100)).toFixed(2) %></span>
                                </div>
                                <% } %>

                                <div class="sg-summary-row">
                                    <span>Shipping</span>
                                    <span>₹300</span>
                                </div>

                                <div class="sg-summary-divider"></div>

                                <div class="sg-summary-total">
                                    <span class="sg-summary-total-label">Grand total</span>
                                    <span class="sg-summary-total-price">₹<%= orderData.payableAmount.toFixed(2) %></span>
                                </div>

                                <div class="sg-payment-status-row">
                                    <span class="sg-payment-status-label">Payment status</span>
                                    <span class="sg-payment-badge">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                        <%= orderData.paymentStatus %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <% if(invoice) { %>
                        <a class="sg-btn-invoice" href="/invoice/<%= orderData.orderId %>">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Download Invoice
                        </a>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script>
        document.getElementById('logoutBtn').addEventListener('click', async (e) => {
            e.preventDefault();

            await fetch('/logout', {
                method: 'POST'
            });

            window.location.href = '/login';
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="user/assets/js/auto_complete.js"></script>
    <script src="user/assets/js/vendor/modernizr-3.6.0.min.js"></script>
    <script src="user/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="user/assets/js/vendor/jquery-migrate-3.3.0.min.js"></script>
    <script src="user/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="user/assets/js/plugins/slick.js"></script>
    <script src="user/assets/js/plugins/wow.js"></script>
    <script src="user/assets/js/plugins/perfect-scrollbar.js"></script>
    <script src="user/assets/js/plugins/scrollup.js"></script>
    <script src="./user/assets/js/main.js?v=3.4"></script>
    <script src="./user/assets/js/shop.js?v=3.4"></script>
</body>
</html>