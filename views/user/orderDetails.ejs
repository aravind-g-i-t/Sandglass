<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Order Details</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">

    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #1D9E75;
            --success-bg: #E8F8F2;
            --warning: #D97706;
            --warning-bg: #FEF3C7;
        }

        .header-area {
            display: none !important;
        }

        html,
        body {
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
            background: var(--gray-50);
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
        }

        .sg-search {
            position: relative;
            flex: 0 0 220px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder {
            color: var(--gray-200);
        }

        .sg-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            pointer-events: none;
        }

        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }


        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: 12px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(60,52,137,0.10);
    display: none;
    z-index: 200;
}

.sg-dropdown.active {
    display: block;
}


        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.12s;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown a.danger {
            color: var(--danger);
        }

        .sg-dropdown a.danger:hover {
            background: var(--danger-bg);
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        /* ── Navbar ── */
        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
        }

        .sg-navbar a:hover,
        .sg-navbar a.active {
            color: #fff;
        }

        /* ── Page offset ── */
        .sg-offset {
            padding-top: 110px;
        }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            background: var(--white);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 0;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-breadcrumb .container {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-breadcrumb a {
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-breadcrumb a:hover {
            text-decoration: underline;
        }

        .sg-breadcrumb .bc-sep {
            color: var(--gray-200);
        }

        .sg-breadcrumb .bc-current {
            color: var(--gray-900);
            font-weight: 500;
        }

        /* ── Page layout ── */
        .sg-page {
            padding: 40px 0 64px;
        }

        /* ── Page title row ── */
        .sg-page-title-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .sg-page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--gray-900);
        }

        .sg-order-meta {
            font-size: 13px;
            color: var(--gray-400);
            margin-top: 4px;
        }

        .sg-order-id {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--purple-50);
            border: 1px solid var(--purple-100);
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            color: var(--purple-800);
        }

        /* ── Info cards row ── */
        .sg-info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .sg-info-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            padding: 20px 22px;
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .sg-info-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--purple-50);
            border: 1px solid var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--purple-600);
        }

        .sg-info-label {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--gray-400);
            margin-bottom: 6px;
        }

        .sg-info-value {
            font-size: 13px;
            color: var(--gray-600);
            line-height: 1.65;
        }

        .sg-info-value strong {
            color: var(--gray-900);
            font-weight: 500;
        }

        .sg-info-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            font-weight: 500;
            color: var(--purple-600);
            text-decoration: none;
            margin-top: 8px;
        }

        .sg-info-link:hover {
            text-decoration: underline;
        }

        /* ── Products table card ── */
        .sg-table-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .sg-table-card-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--gray-100);
            font-size: 15px;
            font-weight: 500;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .sg-table thead {
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-table thead th {
            padding: 12px 20px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--gray-400);
            text-align: left;
        }

        .sg-table thead th.text-right {
            text-align: right;
        }

        .sg-table tbody tr {
            border-bottom: 1px solid var(--gray-100);
            transition: background 0.12s;
        }

        .sg-table tbody tr:last-child {
            border-bottom: none;
        }

        .sg-table tbody tr:hover {
            background: var(--gray-50);
        }

        .sg-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .sg-table tbody td.text-right {
            text-align: right;
        }

        .sg-product-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sg-product-thumb {
            width: 52px;
            height: 52px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--gray-100);
            flex-shrink: 0;
        }

        .sg-product-cell-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            max-width: 220px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
