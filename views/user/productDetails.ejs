<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — <%= product.productName %>
    </title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">

    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #1D9E75;
        }

        /* hide original header */
        .header-area {
            display: none !important;
        }

        /* ── Sandglass Header ── */
        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
            font-family: 'DM Sans', sans-serif;
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-search {
            position: relative;
            flex: 0 0 240px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder {
            color: var(--gray-200);
        }

        .sg-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            pointer-events: none;
        }

        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s, border-color 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            border-color: var(--gray-200);
            color: var(--gray-900);
        }


        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: 12px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(60,52,137,0.10);
    display: none;
    z-index: 200;
}

.sg-dropdown.active {
    display: block;
}


        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.12s;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown a.danger {
            color: var(--danger);
        }

        .sg-dropdown a.danger:hover {
            background: var(--danger-bg);
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        /* ── Nav bar ── */
        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
        }

        .sg-navbar a:hover,
        .sg-navbar a.active {
            color: #fff;
        }

        /* ── Page offset ── */
        .sg-page-offset {
            padding-top: 110px;
        }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            background: var(--white);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 0;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-breadcrumb .container {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-breadcrumb a {
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-breadcrumb a:hover {
            text-decoration: underline;
        }

        .sg-breadcrumb-sep {
            color: var(--gray-200);
        }

        .sg-breadcrumb-current {
            color: var(--gray-900);
            font-weight: 500;
        }

        /* ── Product detail section ── */
        .sg-product-section {
            padding: 48px 0 64px;
            background:
                radial-gradient(ellipse 40% 30% at 95% 5%, var(--purple-50) 0%, transparent 60%),
                var(--gray-50);
            font-family: 'DM Sans', sans-serif;
        }

        /* Gallery */
        .sg-gallery-wrap {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            overflow: hidden;
            padding: 20px;
        }

        /* Product info card */
        .sg-product-info {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 36px 40px;
            height: 100%;
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .sg-product-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.25;
            margin-bottom: 16px;
        }

        .sg-rating-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .sg-stars {
            display: flex;
            gap: 3px;
        }

        .sg-star {
            color: #F5A623;
            font-size: 14px;
        }

        .sg-star-empty {
            color: var(--gray-200);
            font-size: 14px;
        }

        .sg-review-count {
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 20px 0;
        }

        /* Pricing */
        .sg-price-block {
            margin-bottom: 20px;
        }

        .sg-price-current {
            font-family: 'DM Serif Display', serif;
            font-size: 32px;
            font-weight: 400;
            color: var(--purple-800);
        }

        .sg-price-row {
            display: flex;
            align-items: baseline;
            gap: 12px;
            flex-wrap: wrap;
        }

        .sg-price-old {
            font-size: 17px;
            color: var(--gray-400);
            text-decoration: line-through;
        }

        .sg-price-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            background: #E8F8F2;
            border: 1px solid #9FE1CB;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            color: var(--success);
        }

        /* Description */
        .sg-description {
            font-size: 14px;
            color: var(--gray-600);
            line-height: 1.65;
            margin-bottom: 24px;
        }

        /* Stock badge */
        .sg-stock {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 24px;
        }

        .sg-stock.in-stock {
            background: #E8F8F2;
            color: var(--success);
            border: 1px solid #9FE1CB;
        }

        .sg-stock.out-of-stock {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid #F7C1C1;
        }

        /* Action buttons */
        .sg-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .sg-btn-cart {
            flex: 1;
            min-width: 160px;
            padding: 13px 20px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .sg-btn-cart:hover {
            background: var(--purple-900);
        }

        .sg-btn-cart:active {
            transform: scale(0.98);
        }

        .sg-btn-wishlist {
            width: 48px;
            height: 48px;
            border: 1px solid var(--gray-200);
            border-radius: 10px;
            background: var(--white);
            color: var(--gray-600);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
            font-size: 18px;
        }

        .sg-btn-wishlist:hover {
            border-color: var(--danger);
            color: var(--danger);
            background: var(--danger-bg);
        }

        .sg-btn-wishlist.wishlisted {
            border-color: var(--danger);
            color: var(--danger);
            background: var(--danger-bg);
        }

        .sg-unavailable {
            padding: 14px 20px;
            background: var(--gray-50);
            border: 1px solid var(--gray-200);
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-400);
            text-align: center;
        }

        /* Trust badges */
        .sg-trust {
            display: flex;
            gap: 16px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--gray-100);
        }

        .sg-trust-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--gray-600);
        }

        .sg-trust-icon {
            color: var(--purple-400);
        }

        /* ── Reviews & Related ── */
        .sg-section {
            padding: 56px 0;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-section-alt {
            background: var(--gray-50);
        }

        .sg-section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 24px;
            font-weight: 400;
            color: var(--gray-900);
            margin-bottom: 28px;
        }

        /* Review card */
        .sg-review-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 14px;
            padding: 20px 24px;
            margin-bottom: 16px;
            display: flex;
            gap: 16px;
        }

        .sg-reviewer-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .sg-reviewer-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            margin-bottom: 4px;
        }

        .sg-reviewer-since {
            font-size: 11px;
            color: var(--gray-400);
            margin-bottom: 8px;
        }

        .sg-review-text {
            font-size: 14px;
            color: var(--gray-600);
            line-height: 1.6;
            margin-bottom: 8px;
        }

        .sg-review-meta {
            font-size: 12px;
            color: var(--gray-400);
        }

        /* Rating summary */
        .sg-rating-summary {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 14px;
            padding: 24px;
        }

        .sg-rating-big {
            font-family: 'DM Serif Display', serif;
            font-size: 48px;
            color: var(--gray-900);
            line-height: 1;
            margin-bottom: 8px;
        }

        .sg-rating-label {
            font-size: 13px;
            color: var(--gray-400);
            margin-bottom: 20px;
        }

        .sg-rating-bar-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
            font-size: 12px;
            color: var(--gray-600);
        }

        .sg-rating-bar-label {
            width: 32px;
            flex-shrink: 0;
        }

        .sg-rating-bar-track {
            flex: 1;
            height: 6px;
            background: var(--gray-100);
            border-radius: 3px;
            overflow: hidden;
        }

        .sg-rating-bar-fill {
            height: 100%;
            background: #F5A623;
            border-radius: 3px;
        }

        /* Review form */
        .sg-review-form {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            padding: 28px 32px;
        }

        .sg-review-form h4 {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            font-weight: 400;
            color: var(--gray-900);
            margin-bottom: 20px;
        }

        .sg-form-group {
            margin-bottom: 16px;
        }

        .sg-form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            margin-bottom: 7px;
        }

        .sg-form-group input,
        .sg-form-group textarea {
            width: 100%;
            padding: 10px 14px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
            resize: vertical;
        }

        .sg-form-group input:focus,
        .sg-form-group textarea:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-btn-submit {
            padding: 11px 24px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            transition: background 0.15s;
        }

        .sg-btn-submit:hover {
            background: var(--purple-900);
        }

        /* Related product cards */
        .sg-related-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .sg-product-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
        }

        .sg-product-card:hover {
            box-shadow: 0 8px 28px rgba(60, 52, 137, 0.10);
            transform: translateY(-2px);
        }

        .sg-product-img-wrap {
            position: relative;
            aspect-ratio: 1;
            overflow: hidden;
            background: var(--gray-50);
        }

        .sg-product-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .sg-product-card:hover .sg-product-img-wrap img {
            transform: scale(1.05);
        }

        .sg-related-actions {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            opacity: 0;
            transform: translateX(6px);
            transition: opacity 0.2s, transform 0.2s;
        }

        .sg-product-card:hover .sg-related-actions {
            opacity: 1;
            transform: translateX(0);
        }

        .sg-related-action-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--white);
            border: 1px solid var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: var(--gray-600);
            transition: all 0.15s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            cursor: pointer;
        }

        .sg-related-action-btn:hover {
            background: var(--purple-800);
            color: #fff;
            border-color: var(--purple-800);
        }

        .sg-product-body {
            padding: 14px;
        }

        .sg-product-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
            margin-bottom: 8px;
            display: block;
        }

        .sg-product-name:hover {
            color: var(--purple-800);
        }

        .sg-product-price {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .sg-price-final {
            font-size: 16px;
            font-weight: 500;
            color: var(--purple-800);
        }

        .sg-price-mrp {
            font-size: 13px;
            color: var(--gray-400);
            text-decoration: line-through;
        }

        /* Red heart (wishlisted) */
        .fi-rs-heart.red {
            color: var(--danger) !important;
        }

        /* ── Footer ── */
        footer.main {
            font-family: 'DM Sans', sans-serif;
        }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .sg-header-inner {
                padding: 0 20px;
            }

            .sg-search {
                display: none;
            }

            .sg-navbar {
                display: none;
            }

            .sg-product-info {
                padding: 24px;
            }

            .sg-related-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .sg-page-offset {
                padding-top: 64px;
            }
        }

        @media (max-width: 480px) {
            .sg-related-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- Quick view modal -->
    <div class="modal fade custom-modal" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="detail-gallery">
                                <div class="product-image-slider">
                                    <figure class="border-radius-10"><img src="user/assets/imgs/shop/product-16-2.jpg"
                                            alt="product image"></figure>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="detail-info">
                                <h3 class="title-detail mt-30">
                                    <%= product.productName %>
                                </h3>
                                <div class="clearfix product-price-cover">
                                    <div class="product-price primary-color float-left">
                                        <ins><span class="text-brand">₹<%= product.finalPrice %></span></ins>
                                        <ins><span class="old-price font-md ml-15">₹<%= product.price %></span></ins>
                                        <span class="save-price font-md color3 ml-15">
                                            <%= Math.round((product.price - product.finalPrice) / product.price * 100)
                                                %>% Off
                                        </span>
                                    </div>
                                </div>
                                <div class="bt-1 border-color-1 mt-15 mb-15"></div>
                                <div class="detail-extralink">
                                    <div class="product-extra-link2">
                                        <% if (product.stock==0) { %>
                                            <h2>Currently unavailable</h2>
                                            <% } else { %>
                                                <button type="submit" onclick="addToCart('<%= product._id %>')"
                                                    class="button button-add-to-cart">Add to cart</button>
                                                <% } %>
                                                    <a onclick="addToWishlist('<%= product._id %>')"
