<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Contact</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
        }

        body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--gray-900); margin: 0; }

        .header-area { display: none !important; }

        /* ── Header ── */
        .sg-header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1050;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
            font-family: 'DM Sans', sans-serif;
        }

        .sg-header-inner {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 48px; height: 64px;
        }

        .sg-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
        .sg-logo-icon { width: 32px; height: 32px; background: var(--purple-800); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .sg-logo-text { font-family: 'DM Serif Display', serif; font-size: 20px; color: var(--gray-900); letter-spacing: -0.2px; }

        .sg-nav { display: flex; align-items: center; gap: 32px; list-style: none; margin: 0; padding: 0; }
        .sg-nav a { font-size: 14px; font-weight: 500; color: var(--gray-600); text-decoration: none; transition: color 0.15s; }
        .sg-nav a:hover, .sg-nav a.active { color: var(--purple-800); }

        .sg-search { position: relative; flex: 0 0 240px; }
        .sg-search input { width: 100%; padding: 8px 12px 8px 36px; font-size: 13px; font-family: 'DM Sans', sans-serif; border: 1px solid var(--gray-200); border-radius: 8px; background: var(--gray-50); color: var(--gray-900); outline: none; transition: border-color 0.15s, box-shadow 0.15s; }
        .sg-search input:focus { border-color: var(--purple-400); box-shadow: 0 0 0 3px var(--purple-50); background: var(--white); }
        .sg-search input::placeholder { color: var(--gray-200); }
        .sg-search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--gray-400); pointer-events: none; }

        .sg-header-actions { display: flex; align-items: center; gap: 8px; }

        .sg-icon-btn { width: 38px; height: 38px; border-radius: 8px; border: 1px solid var(--gray-100); background: var(--white); display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; color: var(--gray-600); transition: background 0.15s, border-color 0.15s; }
        .sg-icon-btn:hover { background: var(--gray-50); border-color: var(--gray-200); color: var(--gray-900); }

        .sg-user-wrap { position: relative; }
        .sg-user-btn { display: flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--gray-100); border-radius: 8px; background: var(--white); font-size: 13px; font-weight: 500; font-family: 'DM Sans', sans-serif; color: var(--gray-900); cursor: pointer; text-decoration: none; transition: background 0.15s; }
        .sg-user-btn:hover { background: var(--gray-50); color: var(--gray-900); }
        .sg-user-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--purple-100); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--purple-800); }

        .sg-dropdown { position: absolute; right: 0; top: calc(100% + 8px); background: var(--white); border: 1px solid var(--gray-100); border-radius: 12px; padding: 6px; min-width: 180px; box-shadow: 0 8px 24px rgba(60,52,137,0.10); display: none; z-index: 200; }
        .sg-dropdown.active { display: block; }
        .sg-dropdown a { display: flex; align-items: center; gap: 8px; padding: 9px 12px; font-size: 13px; color: var(--gray-900); text-decoration: none; border-radius: 8px; transition: background 0.12s; }
        .sg-dropdown a:hover { background: var(--gray-50); }
        .sg-dropdown a.danger { color: #E24B4A; }
        .sg-dropdown a.danger:hover { background: #FCEBEB; }
        .sg-dropdown-divider { height: 1px; background: var(--gray-100); margin: 4px 0; }

        .sg-navbar { position: fixed; top: 64px; left: 0; right: 0; z-index: 1040; background: var(--purple-900); display: flex; align-items: center; justify-content: center; gap: 40px; padding: 0 48px; height: 46px; }
        .sg-navbar a { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.75); text-decoration: none; transition: color 0.15s; letter-spacing: 0.01em; }
        .sg-navbar a:hover, .sg-navbar a.active { color: #fff; }

        .sg-page-offset { padding-top: 110px; }

        /* ── Contact Hero ── */
        .contact-hero {
            background:
                radial-gradient(ellipse 50% 60% at 100% 0%, var(--purple-50) 0%, transparent 60%),
                radial-gradient(ellipse 40% 40% at 0% 100%, var(--purple-100) 0%, transparent 55%),
                var(--purple-900);
            padding: 80px 0 72px;
            text-align: center;
        }

        .contact-hero-inner { max-width: 680px; margin: 0 auto; padding: 0 48px; }

        .contact-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--purple-200);
            background: rgba(175,169,236,0.15); border: 1px solid rgba(175,169,236,0.3);
            padding: 5px 14px; border-radius: 20px; margin-bottom: 24px;
        }

        .contact-hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 48px; font-weight: 400; color: #fff;
            line-height: 1.15; margin: 0 0 20px;
        }

        .contact-hero h1 em { font-style: italic; color: var(--purple-200); }

        .contact-hero p { font-size: 16px; color: rgba(255,255,255,0.65); line-height: 1.75; margin: 0 0 36px; }

        .contact-hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

        .btn-white {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            background: #fff; color: var(--purple-900);
            text-decoration: none; border: none; cursor: pointer;
            transition: background 0.15s;
        }
        .btn-white:hover { background: var(--purple-50); color: var(--purple-900); }

        .btn-ghost {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            background: rgba(255,255,255,0.1); color: #fff;
            border: 1px solid rgba(255,255,255,0.2); text-decoration: none;
            transition: background 0.15s;
        }
        .btn-ghost:hover { background: rgba(255,255,255,0.18); color: #fff; }

        /* ── Contact info cards ── */
        .contact-info-section {
            padding: 72px 0 0;
            background: var(--gray-50);
        }

        .contact-info-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 48px;
        }

        .section-eyebrow {
            font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--purple-600);
            display: block; margin-bottom: 12px;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: 36px; font-weight: 400; color: var(--gray-900);
            margin: 0 0 16px; line-height: 1.2;
        }

        .section-lead {
            font-size: 15px; color: var(--gray-600); line-height: 1.75;
            margin: 0 0 48px; max-width: 520px;
        }

        .locations-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
            padding-bottom: 72px;
        }

        .location-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; padding: 28px 24px;
            transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
        }
        .location-card:hover {
            box-shadow: 0 8px 28px rgba(60,52,137,0.10);
            transform: translateY(-3px);
            border-color: var(--purple-200);
        }

        .location-icon {
            width: 44px; height: 44px; border-radius: 12px;
            background: var(--purple-50); border: 1px solid var(--purple-100);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 16px;
        }

        .location-icon svg { color: var(--purple-800); }

        .location-title { font-size: 15px; font-weight: 600; color: var(--gray-900); margin: 0 0 10px; }

        .location-detail {
            font-size: 13.5px; color: var(--gray-600); line-height: 1.7;
            margin: 0 0 16px;
        }

        .location-detail a { color: var(--purple-600); text-decoration: none; }
        .location-detail a:hover { text-decoration: underline; }

        .map-link {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 12.5px; font-weight: 500; color: var(--purple-600);
            text-decoration: none; padding: 6px 14px;
            border: 1px solid var(--purple-200); border-radius: 8px;
            background: var(--purple-50); transition: all 0.15s;
        }
        .map-link:hover { background: var(--purple-100); color: var(--purple-800); }

        /* ── Contact channels strip ── */
        .channels-strip {
            background: var(--white);
            border-top: 1px solid var(--gray-100);
            border-bottom: 1px solid var(--gray-100);
            padding: 40px 0;
        }

        .channels-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 48px;
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
        }

        .channel-item {
            display: flex; align-items: center; gap: 14px;
            padding: 0 24px;
            border-right: 1px solid var(--gray-100);
        }
        .channel-item:last-child { border-right: none; }

        .channel-icon {
            width: 42px; height: 42px; border-radius: 12px;
            background: var(--purple-50); flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .channel-icon svg { color: var(--purple-800); }

        .channel-label { font-size: 11px; color: var(--gray-400); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px; }
        .channel-value { font-size: 13.5px; font-weight: 500; color: var(--gray-900); }

        /* ── Contact Form ── */
        .contact-form-section { padding: 80px 0; background: var(--gray-50); }

        .contact-form-inner {
            max-width: 760px; margin: 0 auto; padding: 0 48px;
        }

        .form-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 20px; padding: 48px;
            box-shadow: 0 4px 32px rgba(60,52,137,0.06);
        }

        .form-card-header { text-align: center; margin-bottom: 36px; }
        .form-card-header h2 { font-family: 'DM Serif Display', serif; font-size: 30px; font-weight: 400; color: var(--gray-900); margin: 0 0 10px; }
        .form-card-header p { font-size: 14px; color: var(--gray-600); margin: 0; line-height: 1.65; }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group.full { grid-column: 1 / -1; }

        .form-group label { font-size: 12.5px; font-weight: 500; color: var(--gray-600); }

        .form-control {
            width: 100%; padding: 10px 14px;
            border: 1px solid var(--gray-200); border-radius: 10px;
            background: var(--gray-50); color: var(--gray-900);
            font-size: 13.5px; font-family: 'DM Sans', sans-serif;
            outline: none; transition: border-color 0.15s, box-shadow 0.15s;
        }
        .form-control:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }
        .form-control::placeholder { color: var(--gray-200); }

        textarea.form-control { resize: vertical; min-height: 130px; }

        .form-submit-row { margin-top: 8px; }

        .btn-submit {
            width: 100%; padding: 13px;
            background: var(--purple-800); color: #fff;
            border: none; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            cursor: pointer; transition: background 0.15s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-submit:hover { background: var(--purple-900); }

        /* Footer */
        footer.main { font-family: 'DM Sans', sans-serif; }

        /* Responsive */
        @media (max-width: 1024px) {
            .locations-grid { grid-template-columns: repeat(2, 1fr); }
            .channels-inner { grid-template-columns: repeat(2, 1fr); gap: 20px; }
            .channel-item { border-right: none; border-bottom: 1px solid var(--gray-100); padding-bottom: 20px; }
            .channel-item:nth-child(2n) { border-bottom: none; }
        }

        @media (max-width: 768px) {
            .sg-header-inner { padding: 0 20px; }
            .sg-search, .sg-nav { display: none; }
            .sg-navbar { display: none; }
            .sg-page-offset { padding-top: 64px; }
            .contact-hero h1 { font-size: 32px; }
            .contact-hero-inner, .contact-info-inner, .contact-form-inner, .channels-inner { padding: 0 20px; }
            .locations-grid { grid-template-columns: 1fr; }
            .channels-inner { grid-template-columns: 1fr; }
            .form-grid { grid-template-columns: 1fr; }
            .form-card { padding: 28px 20px; }
        }
    </style>
</head>

<body>

    <!-- ── Header ── -->
    <header class="sg-header">
        <div class="sg-header-inner">
            <a href="/" class="sg-logo">
                <div class="sg-logo-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                    </svg>
                </div>
                <span class="sg-logo-text">Sandglass</span>
            </a>

            <div class="sg-search">
                <span class="sg-search-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                </span>
                <form action="/shop" method="get">
                    <input name="search" type="text" placeholder="Search for items…">
                </form>
            </div>

            <div class="sg-header-actions">
                <% if(userData) { %>
                    <a href="/wishlist" class="sg-icon-btn" title="Wishlist">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </a>
                    <a href="/cart" class="sg-icon-btn" title="Cart">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 01-8 0"/>
                        </svg>
                    </a>
                    <div class="sg-user-wrap">
                        <a id="userDropdownBtn" class="sg-user-btn">
                            <div class="sg-user-avatar"><%= userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %></div>
                            <%= userData.username %>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </a>
                        <div class="sg-dropdown">
                            <a href="/profile">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profile
                            </a>
                            <div class="sg-dropdown-divider"></div>
                            <a href="#" id="logoutBtn" class="danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                                Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="sg-user-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Log in
                    </a>
                    <a href="/signup" style="padding:7px 14px;background:var(--purple-800);color:#fff;border-radius:8px;font-size:13px;font-weight:500;font-family:'DM Sans',sans-serif;text-decoration:none;transition:background 0.15s;" onmouseover="this.style.background='var(--purple-900)'" onmouseout="this.style.background='var(--purple-800)'">Sign up</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- ── Navbar ── -->
    <nav class="sg-navbar">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/about">About</a>
        <a href="/contact" class="active">Contact</a>
    </nav>

    <div class="sg-page-offset"></div>

    <!-- ── Hero ── -->
    <section class="contact-hero">
        <div class="contact-hero-inner">
            <div class="contact-eyebrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.7A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                Get in Touch
            </div>
            <h1>Let's Talk About<br><em>Your Perfect Timepiece</em></h1>
            <p>Whether you have questions about our products, need help finding the right watch, or just want to say hello — we're here and happy to hear from you.</p>
            <div class="contact-hero-actions">
                <a href="#contact-form" class="btn-white">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Send a Message
                </a>
                <a href="/about" class="btn-ghost">About Us</a>
            </div>
        </div>
    </section>

    <!-- ── Contact channels strip ── -->
    <div class="channels-strip">
        <div class="channels-inner">
            <div class="channel-item">
                <div class="channel-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.7A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                </div>
                <div>
                    <div class="channel-label">Phone</div>
                    <div class="channel-value">+91 97511 25454</div>
                </div>
            </div>
            <div class="channel-item">
                <div class="channel-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                    <div class="channel-label">Email</div>
                    <div class="channel-value">contact@sandglass.com</div>
                </div>
            </div>
            <div class="channel-item">
                <div class="channel-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                    <div class="channel-label">Working Hours</div>
