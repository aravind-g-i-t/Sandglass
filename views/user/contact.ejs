        if (userBtn) {
            const dropdown = document.querySelector('.sg-dropdown');
            userBtn.addEventListener('click', (e) => { e.preventDefault(); dropdown.classList.toggle('active'); });
            document.addEventListener('click', (e) => { if (!e.target.closest('.sg-user-wrap')) dropdown.classList.remove('active'); });
        }

