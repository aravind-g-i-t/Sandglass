<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Set Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
        }

        html,
        body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
        }

        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 40px;
            display: flex;
            align-items: center;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 30px;
            height: 30px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 19px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 40px 60px;
            background: radial-gradient(ellipse 55% 45% at 85% 15%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 8% 85%, var(--purple-100) 0%, transparent 60%), var(--gray-50);
        }

        .sg-card-wrap {
            width: 100%;
            max-width: 480px;
        }

        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 52px 56px;
            box-shadow: 0 4px 32px rgba(60, 52, 137, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);
            animation: fadeUp 0.4s ease both;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .sg-icon-circle {
            width: 56px;
            height: 56px;
            background: var(--purple-50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 8px;
            text-align: center;
        }

        .sg-title {
            font-family: 'DM Serif Display', serif;
            font-size: 26px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.2;
            margin-bottom: 6px;
            text-align: center;
        }

        .sg-subtitle {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 32px;
            text-align: center;
        }

        .alert-danger {
            background: var(--danger-bg);
            border: 1px solid #F7C1C1;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: var(--danger);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-field {
            margin-bottom: 20px;
        }

        .sg-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            margin-bottom: 7px;
            display: block;
        }

        .sg-input-wrap {
            position: relative;
        }

        .sg-input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-200);
            pointer-events: none;
            display: flex;
        }

        .sg-input-wrap input {
            width: 100%;
            padding: 11px 13px 11px 40px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-input-wrap input::placeholder {
            color: var(--gray-200);
        }

        .sg-input-wrap input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        /* Password strength bar */
        .sg-strength {
            margin-top: 8px;
        }

        .sg-strength-bar {
            height: 4px;
            border-radius: 2px;
            background: var(--gray-100);
            margin-bottom: 4px;
            overflow: hidden;
        }

        .sg-strength-fill {
            height: 100%;
            border-radius: 2px;
            width: 0%;
            transition: width 0.3s, background 0.3s;
        }

        .sg-strength-label {
            font-size: 11px;
            color: var(--gray-400);
        }

        .sg-btn-primary {
            width: 100%;
            padding: 12px 16px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
            margin-top: 8px;
        }

        .sg-btn-primary:hover {
            background: var(--purple-900);
        }

        .sg-btn-primary:active {
            transform: scale(0.98);
        }

        .sg-back {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-back a {
            color: var(--purple-600);
            font-weight: 500;
            text-decoration: none;
        }

        .sg-back a:hover {
            text-decoration: underline;
        }

        .sg-page-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 12px;
        }

        @media(max-width:600px) {
            .sg-page {
                padding: 90px 20px 40px;
            }

            .sg-card {
                padding: 36px 24px;
            }
        }
    </style>
</head>

<body>
    <header class="sg-header">
        <a href="/" class="sg-logo">
            <div class="sg-logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4" />
                </svg>
            </div>
            <span class="sg-logo-text">Sandglass</span>
        </a>
    </header>

    <div class="sg-page">
        <div class="sg-card-wrap">
            <div class="sg-card">
                <div class="sg-icon-circle">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#534AB7" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                    </svg>
                </div>
                <p class="sg-eyebrow">Reset Password</p>
                <h1 class="sg-title">Set a new password</h1>
                <p class="sg-subtitle">Choose a strong password for your Sandglass account</p>

                <% if(locals.message) { %>
                    <div class="alert alert-danger" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <%= message %>
                    </div>
                    <% } %>

                        <form action="/set_password" method="post" id="setPasswordForm" novalidate>
                            <div class="sg-field">
                                <label class="sg-label" for="password">New password</label>
                                <div class="sg-input-wrap">
                                    <span class="sg-input-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" />
                                            <path d="M7 11V7a5 5 0 0110 0v4" />
                                        </svg>
                                    </span>
                                    <input type="password" id="password" name="password" placeholder="Min. 8 characters"
                                        required>
                                </div>
                                <div class="sg-strength">
                                    <div class="sg-strength-bar">
                                        <div class="sg-strength-fill" id="strengthFill"></div>
                                    </div>
                                    <span class="sg-strength-label" id="strengthLabel"></span>
                                </div>
                                <span
                                    style="color:var(--danger); font-size:12px; margin-top:5px; display:block; min-height:16px;"
                                    id="password2Error"></span>
                            </div>

                            <div class="sg-field">
                                <label class="sg-label" for="password2">Confirm new password</label>
                                <div class="sg-input-wrap">
                                    <span class="sg-input-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" />
                                            <path d="M7 11V7a5 5 0 0110 0v4" />
                                        </svg>
                                    </span>
                                    <input type="password" id="password2" name="password2"
                                        placeholder="Re-enter your password" required>
                                </div>
                            </div>

                            <button class="sg-btn-primary" type="submit">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                Confirm new password
                            </button>
                        </form>

                        <div class="sg-back">
                            <a href="/login">← Back to login</a>
                        </div>
            </div>
            <p class="sg-page-footer">© 2026 Sandglass. All rights reserved.</p>
        </div>
    </div>

    <script>
        const passwordInput = document.getElementById('password');
        const strengthFill = document.getElementById('strengthFill');
        const strengthLabel = document.getElementById('strengthLabel');

        passwordInput.addEventListener('input', function () {
            const val = this.value;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const levels = [
                { label: '', color: 'transparent', width: '0%' },
                { label: 'Weak', color: '#E24B4A', width: '25%' },
                { label: 'Fair', color: '#F59E0B', width: '50%' },
                { label: 'Good', color: '#3B82F6', width: '75%' },
                { label: 'Strong', color: '#16A34A', width: '100%' },
            ];
            const level = levels[score];
            strengthFill.style.width = level.width;
            strengthFill.style.background = level.color;
            strengthLabel.textContent = val.length ? level.label : '';
            strengthLabel.style.color = level.color;
        });


        document.getElementById('setPasswordForm').addEventListener('submit', function (event) {
            let valid = true;
            document.getElementById('passwordError').textContent = '';
            document.getElementById('password2Error').textContent = '';

            const password = document.getElementById('password').value.trim();
            const password2 = document.getElementById('password2').value.trim();
            const passwordPattern = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[@$.!%*#?&])/;

            if (!password) {
                document.getElementById('passwordError').textContent = 'Password is required.';
                valid = false;
            } else if (password.length < 8) {
                document.getElementById('passwordError').textContent = 'Password must be at least 8 characters long.';
                valid = false;
            } else if (!passwordPattern.test(password)) {
                document.getElementById('passwordError').textContent = 'Password must contain uppercase, lowercase, numbers, and special symbols.';
                valid = false;
            }

            if (!password2) {
                document.getElementById('password2Error').textContent = 'Confirm password is required.';
                valid = false;
            } else if (password2 !== password) {
                document.getElementById('password2Error').textContent = 'Passwords do not match.';
                valid = false;
            }

            if (!valid) {
                event.preventDefault();
            }
        });
    </script>
</body>

</html>