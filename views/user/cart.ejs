            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="user/assets/js/vendor/modernizr-3.6.0.min.js"></script>
            <script src="user/assets/js/vendor/jquery-3.6.0.min.js"></script>
            <script src="user/assets/js/vendor/jquery-migrate-3.3.0.min.js"></script>
            <script src="user/assets/js/vendor/bootstrap.bundle.min.js"></script>
            <script src="user/assets/js/plugins/slick.js"></script>
            <script src="user/assets/js/plugins/wow.js"></script>
            <script src="user/assets/js/plugins/perfect-scrollbar.js"></script>
            <script src="./user/assets/js/main.js?v=3.4"></script>
            <script src="./user/assets/js/shop.js?v=3.4"></script>

            <script>
                // Apply Coupon
                const applyCouponBtn = document.getElementById('applyCouponBtn');
                if (applyCouponBtn) {
                    applyCouponBtn.addEventListener('click', async () => {
                        const couponCode = document.getElementById('couponCode').value;
                        try {
                            const response = await fetch('/apply_coupon', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ couponCode })
                            });
                            const result = await response.json();
                            if (response.status === 200) {
                                Swal.fire({ icon: 'success', title: 'Coupon Applied!', text: result.message, confirmButtonColor: '#3C3489' })
                                    .then(() => window.location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#3C3489' });
                            }
                        } catch (error) {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#3C3489' });
                        }
                    });
                }

                // Remove Coupon
                const removeCouponBtn = document.getElementById('removeCouponBtn');
                if (removeCouponBtn) {
                    removeCouponBtn.addEventListener('click', async () => {
                        try {
                            const response = await fetch('/remove_coupon', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const result = await response.json();
                            if (response.status === 200) {
                                Swal.fire({ icon: 'success', title: 'Coupon Removed!', text: result.message, confirmButtonColor: '#3C3489' })
                                    .then(() => window.location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#3C3489' });
                            }
                        } catch (error) {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#3C3489' });
                        }
                    });
                }

                // Update Quantity
                async function quantityUpdate(productId, status) {
                    try {
                        let response = await fetch('/cart/quantity', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId, status })
                        });
                        if (!response.ok) throw new Error('Network error');
                        let data = await response.json();

                        if (data.message === 'product exceeded') {
                            await Swal.fire('Stock Exceeded', 'Cannot increase quantity beyond available stock.', 'error');
                            location.reload();
                        } else if (data.message === 'Max 10') {
                            await Swal.fire('Maximum Quantity', 'Cannot add more than 10 of the same item.', 'error');
                            location.reload();
                        } else if (data.message === 'Min 1') {
                            await Swal.fire('Minimum Quantity', 'Quantity cannot be less than 1.', 'error');
                            location.reload();
                        } else {
                            document.getElementById(`quantity${data.productData._id}`).innerText = data.quantity;
                            document.getElementById(`totalPrice${data.productData._id}`).innerText = '₹' + (data.quantity * data.finalPrice);
                            document.getElementById(`price${data.productData._id}`).innerText = '₹' + data.finalPrice;
                            document.getElementById('subTotal').innerText = '₹' + data.total;
                            document.getElementById('total').innerText = '₹' + (data.total + 300 - data.discount);
                            if (data.discount) {
                                document.getElementById('discount').innerText = '−₹' + data.discount;
                            }
                        }
                    } catch (error) {
                        await Swal.fire('Error', 'Something went wrong. Please try again.', 'error');
                    }
                }

                // Remove Product
                async function removeProduct(productId, productPrice) {
                    const result = await Swal.fire({
                        title: 'Remove item?',
                        text: 'Are you sure you want to remove this item from your cart?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#E24B4A',
                        cancelButtonColor: '#EEECE8',
                        confirmButtonText: 'Remove'
                    });
                    if (result.isConfirmed) {
                        const response = await fetch('/cart/remove_product', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId, productPrice })
                        });
                        if (response.ok) {
                            await Swal.fire({ title: 'Removed!', text: 'Item removed from cart.', icon: 'success', confirmButtonColor: '#3C3489' });
                            window.location.reload();
                        } else {
                            await Swal.fire('Error!', 'There was a problem removing the item.', 'error');
                        }
                    }
                }
            </script>

            <script>
                const userBtn = document.getElementById('userDropdownBtn');
                const dropdown = document.querySelector('.sg-dropdown');

                userBtn.addEventListener('click', (e) => {
                    e.preventDefault();

                    dropdown.classList.toggle('active');
                });

                document.addEventListener('click', (e) => {
                    if (
                        !e.target.closest('.sg-user-wrap')
                    ) {
                        dropdown.classList.remove('active');
                    }
                });
            </script>
