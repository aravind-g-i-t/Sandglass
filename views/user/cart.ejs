    <title>Sandglass — Cart</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">

    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #2D9E6B;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--gray-50);
            color: var(--gray-900);
            margin: 0;
        }

        .header-area {
            display: none !important;
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
            gap: 20px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-nav {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sg-nav a {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-600);
            text-decoration: none;
            transition: color 0.15s;
        }

        .sg-nav a:hover,
        .sg-nav a.active {
            color: var(--purple-800);
        }

        .sg-search {
            position: relative;
            flex: 0 0 240px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder {
            color: var(--gray-200);
        }

        .sg-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            pointer-events: none;
        }

        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s, border-color 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            border-color: var(--gray-200);
            color: var(--gray-900);
        }



        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: 12px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(60,52,137,0.10);
    display: none;
    z-index: 200;
}

.sg-dropdown.active {
    display: block;
}


        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.12s;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown a.danger {
            color: var(--danger);
        }

        .sg-dropdown a.danger:hover {
            background: var(--danger-bg);
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
            letter-spacing: 0.01em;
        }

        .sg-navbar a:hover,
        .sg-navbar a.active {
            color: #fff;
        }

        .sg-page-offset {
            padding-top: 110px;
        }

        /* ── Page ── */
        .sg-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 48px 64px;
        }

        .sg-breadcrumb {
            padding: 20px 0 0;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-breadcrumb a {
            color: var(--gray-400);
            text-decoration: none;
        }

        .sg-breadcrumb a:hover {
            color: var(--purple-800);
        }

        .sg-breadcrumb span {
            margin: 0 8px;
        }

        .sg-page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 26px;
            font-weight: 400;
            color: var(--gray-900);
            margin: 20px 0 28px;
        }

        /* ── Card ── */
        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
        }

        .sg-card-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-card-header h5 {
            font-family: 'DM Serif Display', serif;
            font-size: 17px;
            font-weight: 400;
            color: var(--gray-900);
            margin: 0;
        }

        /* ── Cart table ── */
        .sg-cart-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .sg-cart-table thead th {
            padding: 12px 20px;
            text-align: left;
            font-size: 11px;
            font-weight: 500;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-cart-table tbody td {
            padding: 16px 20px;
            border-bottom: 1px solid var(--gray-100);
            vertical-align: middle;
        }

        .sg-cart-table tbody tr:last-child td {
            border-bottom: none;
        }

        .sg-cart-table tbody tr:hover td {
            background: var(--gray-50);
        }

        .sg-cart-product {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .sg-cart-img {
            width: 72px;
            height: 72px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--gray-100);
            flex-shrink: 0;
        }

        .sg-cart-product-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            text-decoration: none;
            line-height: 1.4;
        }

        .sg-cart-product-name:hover {
            color: var(--purple-800);
        }

        .sg-stock-warn {
            font-size: 12px;
            color: var(--danger);
            font-weight: 500;
            margin-top: 4px;
        }

        .sg-price {
            font-size: 15px;
            font-weight: 500;
            color: var(--purple-800);
        }

        /* ── Qty control ── */
        .sg-qty {
            display: inline-flex;
            align-items: center;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            overflow: hidden;
            background: var(--white);
        }

        .sg-qty-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--gray-600);
            font-size: 12px;
            transition: background 0.15s, color 0.15s;
        }

        .sg-qty-btn:hover {
            background: var(--purple-50);
            color: var(--purple-800);
        }

        .sg-qty-val {
            min-width: 36px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
            border-left: 1px solid var(--gray-100);
            border-right: 1px solid var(--gray-100);
            padding: 0 4px;
            line-height: 32px;
        }

        .sg-remove-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--gray-400);
            transition: all 0.15s;
        }

        .sg-remove-btn:hover {
            background: var(--danger-bg);
            border-color: var(--danger);
            color: var(--danger);
        }

        /* ── Bottom section ── */
        .sg-cart-bottom {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-top: 24px;
        }

        /* ── Coupon ── */
        .sg-coupon-applied {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            background: var(--purple-50);
            border: 1px solid var(--purple-100);
            border-radius: 10px;
        }

        .sg-coupon-applied span {
            font-size: 13px;
            color: var(--purple-800);
            font-weight: 500;
        }

        .sg-coupon-form {
            display: flex;
            gap: 10px;
        }

        .sg-input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            background: var(--white);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-input::placeholder {
            color: var(--gray-200);
        }

        /* ── Buttons ── */
        .sg-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid transparent;
            transition: all 0.15s;
        }

        .sg-btn-primary {
            background: var(--purple-800);
            color: #fff;
            border-color: var(--purple-800);
        }

        .sg-btn-primary:hover {
            background: var(--purple-900);
            color: #fff;
        }

        .sg-btn-outline {
            background: var(--white);
            color: var(--purple-800);
            border-color: var(--purple-200);
        }

        .sg-btn-outline:hover {
            background: var(--purple-50);
        }

        .sg-btn-danger {
            background: var(--white);
            color: var(--danger);
            border-color: #F5C6C6;
            padding: 6px 12px;
            font-size: 12px;
        }

        .sg-btn-danger:hover {
            background: var(--danger-bg);
            border-color: var(--danger);
        }

        /* ── Order summary ── */
        .sg-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--gray-100);
            font-size: 13px;
        }

        .sg-summary-row:last-child {
            border-bottom: none;
        }

        .sg-summary-label {
            color: var(--gray-600);
        }

        .sg-summary-value {
            font-weight: 500;
            color: var(--gray-900);
        }

        .sg-summary-value.discount {
            color: var(--success);
        }

        .sg-summary-total {
            font-size: 18px;
            font-family: 'DM Serif Display', serif;
            color: var(--purple-800);
        }

        /* ── Empty cart ── */
        .sg-empty {
            text-align: center;
            padding: 80px 20px;
            color: var(--gray-400);
        }

        .sg-empty h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 24px;
            font-weight: 400;
            color: var(--gray-600);
            margin: 20px 0 8px;
        }

        .sg-empty p {
            font-size: 14px;
            margin: 0 0 24px;
        }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .sg-header-inner {
                padding: 0 20px;
            }

            .sg-nav {
                display: none;
            }

            .sg-navbar {
                display: none;
            }

            .sg-wrap {
                padding: 0 20px 48px;
            }

            .sg-cart-bottom {
                grid-template-columns: 1fr;
            }

            .sg-page-offset {
                padding-top: 64px;
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sg-card {
            animation: fadeUp 0.3s ease both;
        }
    </style>
</head>

