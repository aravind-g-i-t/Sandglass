<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — OTP Verification</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #16A34A;
            --success-bg: #DCFCE7;
        }

        html,
        body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
        }

        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 40px;
            display: flex;
            align-items: center;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 30px;
            height: 30px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 19px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 40px 60px;
            background: radial-gradient(ellipse 55% 45% at 85% 15%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 8% 85%, var(--purple-100) 0%, transparent 60%), var(--gray-50);
        }

        .sg-card-wrap {
            width: 100%;
            max-width: 480px;
        }

        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 52px 56px;
            box-shadow: 0 4px 32px rgba(60, 52, 137, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);
            animation: fadeUp 0.4s ease both;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        /* Icon circle */
        .sg-icon-circle {
            width: 56px;
            height: 56px;
            background: var(--purple-50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 8px;
            text-align: center;
        }

        .sg-title {
            font-family: 'DM Serif Display', serif;
            font-size: 26px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.2;
            margin-bottom: 6px;
            text-align: center;
        }

        .sg-subtitle {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 32px;
            text-align: center;
        }

        .alert-danger {
            background: var(--danger-bg);
            border: 1px solid #F7C1C1;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: var(--danger);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* OTP input */
        .sg-otp-wrap {
            position: relative;
            margin-bottom: 8px;
        }

        .sg-otp-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-200);
            pointer-events: none;
            display: flex;
        }

        .sg-otp-input {
            width: 100%;
            padding: 12px 13px 12px 40px;
            font-size: 18px;
            letter-spacing: 0.2em;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
            text-align: center;
        }

        .sg-otp-input::placeholder {
            font-size: 14px;
            letter-spacing: normal;
            color: var(--gray-200);
        }

        .sg-otp-input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        /* Timer */
        .sg-timer {
            text-align: center;
            margin: 16px 0;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-timer span {
            font-weight: 500;
            color: var(--gray-900);
            font-variant-numeric: tabular-nums;
        }

        .sg-timer-expired {
            color: var(--danger);
        }

        #message {
            font-size: 13px;
            text-align: center;
            min-height: 18px;
            margin-bottom: 16px;
        }

        .sg-btn-primary {
            width: 100%;
            padding: 12px 16px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .sg-btn-primary:hover {
            background: var(--purple-900);
        }

        .sg-btn-primary:active {
            transform: scale(0.98);
        }

        .sg-btn-primary:disabled {
            background: var(--gray-200);
            cursor: not-allowed;
        }

        .sg-resend {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-resend a {
            color: var(--purple-600);
            font-weight: 500;
            text-decoration: none;
        }

        .sg-resend a:hover {
            text-decoration: underline;
        }

        .sg-page-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 12px;
        }

        .resend-btn {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: var(--purple-600);
            text-decoration: underline;
            cursor: pointer;
            font: inherit;
        }

        .resend-btn:hover {
            color: var(--purple-800);
        }

        @media(max-width:600px) {
            .sg-page {
                padding: 90px 20px 40px;
            }

            .sg-card {
                padding: 36px 24px;
            }
        }
    </style>
</head>

<body>
    <header class="sg-header">
        <a href="/" class="sg-logo">
            <div class="sg-logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4" />
                </svg>
            </div>
            <span class="sg-logo-text">Sandglass</span>
        </a>
    </header>

    <div class="sg-page">
        <div class="sg-card-wrap">
            <div class="sg-card">
                <div class="sg-icon-circle">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#534AB7" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 7L2 7" />
                    </svg>
                </div>
                <p class="sg-eyebrow">Verification</p>
                <h1 class="sg-title">Check your email</h1>
                <p class="sg-subtitle">An OTP has been sent to your registered email address. Enter it below to
                    continue.</p>

                <% if(locals.message) { %>
                    <div class="alert alert-danger" role="alert">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <%= message %>
                    </div>
                    <% } %>

                        <form method="post" action="/verify_otp">
                            <div class="sg-otp-wrap">
                                <span class="sg-otp-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0110 0v4" />
                                    </svg>
                                </span>
                                <input class="sg-otp-input" type="text" name="otp" id="otp-input"
                                    placeholder="Enter OTP" required maxlength="6" autocomplete="one-time-code">
                            </div>

                            <div class="sg-timer">
                                Time remaining: <span id="countdown">05:00</span>
                            </div>

                            <p id="message"></p>

                            <button class="sg-btn-primary" id="verify-button" type="submit">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                Verify OTP
                            </button>
                        </form>

                        <div class="sg-resend">
                            Didn't receive the code?
                            <form action="/resend_otp" method="POST" style="display:inline;">
                                <button type="submit" class="resend-btn">Resend OTP</button>
                            </form>
                        </div>
            </div>
            <p class="sg-page-footer">© 2026 Sandglass. All rights reserved.</p>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {

        let countdown = 300;

        const countdownElement = document.getElementById('countdown');
        const verifyButton = document.getElementById('verify-button');
        const messageElement = document.getElementById('message');
        const otpInput = document.getElementById('otp-input');
        const form = document.querySelector('form');

        function formatTime(seconds) {

            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;

            return `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`;
        }

        const timer = setInterval(() => {

            countdown--;

            countdownElement.textContent = formatTime(countdown);

            if (countdown <= 0) {

                clearInterval(timer);

                messageElement.textContent = 'OTP expired. Please request a new one.';
                messageElement.style.color = '#E24B4A';

                verifyButton.disabled = true;
                otpInput.disabled = true;
            }

        }, 1000);

        form.addEventListener('submit', (event) => {

            const otp = otpInput.value.trim();

            if (countdown <= 0) {

                event.preventDefault();

                messageElement.textContent = 'OTP expired. Please request a new one.';
                messageElement.style.color = '#E24B4A';

                return;
            }

            if (!/^\d{4}$/.test(otp)) {

                event.preventDefault();

                messageElement.textContent = 'Please enter a valid 4-digit OTP.';
                messageElement.style.color = '#E24B4A';

                return;
            }

            verifyButton.disabled = true;

            verifyButton.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Verifying...
            `;
        });

    });
</script>
</body>

</html>