<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Forgot Password</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --purple-50:  #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50:  #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white:    #FFFFFF;
            --danger:    #E24B4A;
            --danger-bg: #FCEBEB;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: rgba(255,255,255,0.90);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 40px;
            display: flex;
            align-items: center;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 30px; height: 30px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 19px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            position: fixed;
            top: 58px; left: 0; right: 0;
            z-index: 99;
            padding: 10px 40px;
            font-size: 12px;
            color: var(--gray-400);
            background: rgba(247,246,243,0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sg-breadcrumb a {
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-breadcrumb a:hover { text-decoration: underline; }
        .sg-breadcrumb .bc-sep { color: var(--gray-200); }

        /* ── Page ── */
        .sg-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 120px 40px 60px;
            background:
                radial-gradient(ellipse 55% 45% at 85% 15%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 8%  85%, var(--purple-100) 0%, transparent 60%),
                var(--gray-50);
        }

        /* ── Card ── */
        .sg-card-wrap {
            width: 100%;
            max-width: 520px;
        }

        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 52px 60px;
            box-shadow: 0 4px 32px rgba(60,52,137,0.08), 0 1px 4px rgba(0,0,0,0.04);
            animation: fadeUp 0.4s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .sg-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .sg-subtitle {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 32px;
            line-height: 1.5;
        }

        /* ── Alert ── */
        .alert-danger {
            background: var(--danger-bg);
            border: 1px solid #F7C1C1;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: var(--danger);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Field ── */
        .sg-field {
            margin-bottom: 20px;
        }

        .sg-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            margin-bottom: 7px;
            display: block;
        }

        .sg-input-wrap {
            position: relative;
        }

        .sg-input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-200);
            pointer-events: none;
            display: flex;
        }

        .sg-input-wrap input {
            width: 100%;
            padding: 11px 13px 11px 40px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            transition: border-color 0.15s, box-shadow 0.15s;
            outline: none;
        }

        .sg-input-wrap input::placeholder {
            color: var(--gray-200);
        }

        .sg-input-wrap input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-hint {
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 8px;
            display: flex;
            align-items: flex-start;
            gap: 6px;
            line-height: 1.4;
        }

        .sg-hint svg { flex-shrink: 0; margin-top: 1px; }

        /* ── Button ── */
        .sg-btn-primary {
            width: 100%;
            padding: 12px 16px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
            margin-top: 4px;
        }

        .sg-btn-primary:hover { background: var(--purple-900); }
        .sg-btn-primary:active { transform: scale(0.98); }

        /* ── Divider ── */
        .sg-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 24px 0 20px;
        }

        .sg-divider-line {
            flex: 1;
            height: 1px;
            background: var(--gray-100);
        }

        .sg-divider-text {
            font-size: 12px;
            color: var(--gray-200);
        }

        /* ── Back link ── */
        .sg-back {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 13px;
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-back:hover { text-decoration: underline; }

        /* ── Footer ── */
        .sg-page-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 12px;
        }

        /* ── Responsive ── */
        @media (max-width: 600px) {
            .sg-page        { padding: 110px 20px 40px; }
            .sg-card        { padding: 36px 24px; }
            .sg-breadcrumb  { padding: 10px 20px; }
            .sg-header      { padding: 14px 20px; }
        }
    </style>
</head>

<body>

    <header class="sg-header">
        <a href="/" class="sg-logo">
            <div class="sg-logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                </svg>
            </div>
            <span class="sg-logo-text">Sandglass</span>
        </a>
    </header>

    <nav class="sg-breadcrumb">
        <a href="/login">Login</a>
        <span class="bc-sep">›</span>
        <span>Forgot password</span>
    </nav>

    <div class="sg-page">
        <div class="sg-card-wrap">
            <div class="sg-card">

                <p class="sg-eyebrow">Account recovery</p>
                <h1 class="sg-title">Forgot your password?</h1>
                <p class="sg-subtitle">Enter your email address and we'll send you a one-time code to reset your password.</p>

                <!-- Error message (EJS template syntax — remove if not using EJS) -->
                <% if(locals.message) { %>
                <div class="alert-danger" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <%= message %>
                </div>
                <% } %>

                <form id="forgotForm" action="/forgotPassword" method="post" novalidate>
                    <div class="sg-field">
                        <label class="sg-label" for="fp-email">Email address</label>
                        <div class="sg-input-wrap">
                            <span class="sg-input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
                            </span>
                            <input type="email" id="fp-email" name="mail" placeholder="you@example.com" required>
                        </div>
                        <p class="sg-hint">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                            Check your spam folder if you don't see the email within a few minutes.
                        </p>
                        <span class="error" id="emailError" style="font-size:12px;color:#E24B4A;margin-top:5px;display:block;min-height:16px;"></span>
                    </div>

                    <button class="sg-btn-primary" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Send OTP
                    </button>
                </form>

                <div class="sg-divider">
                    <div class="sg-divider-line"></div>
                    <span class="sg-divider-text">or</span>
                    <div class="sg-divider-line"></div>
                </div>

                <a href="/login" class="sg-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    Back to login
                </a>

            </div>
            <p class="sg-page-footer">© 2026 Sandglass. All rights reserved.</p>
        </div>
    </div>

    <script>
        document.getElementById('forgotForm').addEventListener('submit', function(event) {
            document.getElementById('emailError').textContent = '';

            const email = document.getElementById('fp-email');
            if (!email.value) {
                document.getElementById('emailError').textContent = 'Email is required.';
                event.preventDefault();
            } else if (!email.validity.valid) {
                document.getElementById('emailError').textContent = 'Please enter a valid email address.';
                event.preventDefault();
            }
        });
    </script>
    

</body>
</html>