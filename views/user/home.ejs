    <script>
        function switchTab(btn, tabId) {
            document.querySelectorAll('.sg-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.sg-tab-pane').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        async function addToCart(productId) {
            let response = await fetch('product/add_to_cart', {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
            });
            if (!response.ok) {
                console.log(`error --- ${response.statusText}`);
            } else {
                window.location.href = "/cart";
            }
            const data = await response.json();
            console.log(`Data is ${data}`);
        }

        async function addToWishlist(productId) {
            console.log('Selected product Id - ', productId);
            await fetch('/addtowishlist', {
                method: "PUT",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
            }).then(response => {
                if (response.ok) return response.json();
                else throw new Error('Failed to add to wishlist');
            }).then(data => {
                console.log(data.message);
                if (data.message == 'Already added to wishlist') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Product already added to wishlist'
                    });
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'The product has been successfully added to your wishlist!'
                    }).then(() => { window.location.reload(); });
                }
            }).catch(error => {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Login Required',
                    text: 'Login to add the product to wishlist',
                    showCancelButton: true,
                    confirmButtonText: 'Login',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) window.location.href = '/login';
                });
            });
        }
    </script>

    <script>
        const userBtn = document.getElementById('userDropdownBtn');
        const dropdown = document.querySelector('.sg-dropdown');

        userBtn.addEventListener('click', (e) => {
            e.preventDefault();

            dropdown.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (
                !e.target.closest('.sg-user-wrap')
            ) {
                dropdown.classList.remove('active');
            }
        });
    </script>

