<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Home</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">

    <style>
        /* ── Reset & tokens ── */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
        }

        /* ── Override template header with Sandglass header ── */
        .header-area {
            display: none !important;
        }

        /* ── Sandglass Header ── */
        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
            font-family: 'DM Sans', sans-serif;
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        /* Nav */
        .sg-nav {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sg-nav a {
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-600);
            text-decoration: none;
            transition: color 0.15s;
        }

        .sg-nav a:hover,
        .sg-nav a.active {
            color: var(--purple-800);
        }

        /* Search */
        .sg-search {
            position: relative;
            flex: 0 0 240px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder {
            color: var(--gray-200);
        }

        .sg-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            pointer-events: none;
        }

        /* Header actions */
        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s, border-color 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            border-color: var(--gray-200);
            color: var(--gray-900);
        }


        /* User dropdown */
        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 12px;
            padding: 6px;
            min-width: 180px;
            box-shadow: 0 8px 24px rgba(60, 52, 137, 0.10);
            display: none;
            z-index: 200;
        }

        .sg-dropdown.active {
            display: block;
        }



        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.12s;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown a.danger {
            color: #E24B4A;
        }

        .sg-dropdown a.danger:hover {
            background: #FCEBEB;
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        /* Nav bar (below header) */
        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
            letter-spacing: 0.01em;
        }

        .sg-navbar a:hover,
        .sg-navbar a.active {
            color: #fff;
        }

        /* ── Page offset ── */
        .sg-page-offset {
            padding-top: 110px;
        }

        /* ── Hero ── */
        .sg-hero {
            background:
                radial-gradient(ellipse 60% 50% at 80% 20%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 40% 35% at 5% 90%, var(--purple-100) 0%, transparent 55%),
                var(--gray-50);
            padding: 60px 0 48px;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-hero-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 48px;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 32px;
        }

        /* Hero slider card */
        .sg-hero-slider-wrap {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
        }

        /* Hero side banners */
        .sg-hero-side {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sg-side-banner {
            flex: 1;
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            position: relative;
        }

        .sg-side-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sg-side-banner-text {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px;
            background: linear-gradient(to top, rgba(26, 25, 24, 0.70) 0%, transparent 100%);
        }

        .sg-side-banner-text span {
            font-size: 11px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: block;
            margin-bottom: 4px;
        }

        .sg-side-banner-text h4 {
            font-family: 'DM Serif Display', serif;
            font-size: 17px;
            font-weight: 400;
            color: #fff;
            margin: 0 0 8px;
            line-height: 1.25;
        }

        .sg-side-banner-text a {
            font-size: 12px;
            font-weight: 500;
            color: var(--purple-200);
            text-decoration: none;
        }

        .sg-side-banner-text a:hover {
            text-decoration: underline;
        }

        /* ── Section header ── */
        .sg-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 24px;
            font-weight: 400;
            color: var(--gray-900);
        }

        .sg-view-more {
            font-size: 13px;
            font-weight: 500;
            color: var(--purple-600);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .sg-view-more:hover {
            text-decoration: underline;
        }

        /* ── Tab pills ── */
        .sg-tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 28px;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-tab {
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            border: 1px solid var(--gray-200);
            background: var(--white);
            color: var(--gray-600);
            cursor: pointer;
            transition: all 0.15s;
        }

        .sg-tab.active,
        .sg-tab:hover {
            background: var(--purple-800);
            border-color: var(--purple-800);
            color: #fff;
        }

        /* ── Product grid ── */
        .sg-product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .sg-product-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-product-card:hover {
            box-shadow: 0 8px 28px rgba(60, 52, 137, 0.10);
            transform: translateY(-2px);
        }

        .sg-product-img-wrap {
            position: relative;
            aspect-ratio: 1;
            overflow: hidden;
            background: var(--gray-50);
        }

        .sg-product-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .sg-product-card:hover .sg-product-img-wrap img {
            transform: scale(1.05);
        }

        .sg-product-actions {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            opacity: 0;
            transform: translateX(6px);
            transition: opacity 0.2s, transform 0.2s;
        }

        .sg-product-card:hover .sg-product-actions {
            opacity: 1;
            transform: translateX(0);
        }

        .sg-product-action-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--white);
            border: 1px solid var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: var(--gray-600);
            transition: background 0.15s, color 0.15s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .sg-product-action-btn:hover {
            background: var(--purple-800);
            color: #fff;
            border-color: var(--purple-800);
        }

        .sg-product-body {
            padding: 14px;
        }

        .sg-product-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
            margin-bottom: 6px;
        }

        .sg-product-name:hover {
            color: var(--purple-800);
        }

        .sg-product-rating {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 8px;
        }

        .sg-stars {
            display: flex;
            gap: 2px;
        }

        .sg-star {
            color: #F5A623;
            font-size: 12px;
        }

        .sg-product-price {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .sg-price-current {
            font-size: 16px;
            font-weight: 500;
            color: var(--purple-800);
        }

        .sg-price-old {
            font-size: 13px;
            color: var(--gray-400);
            text-decoration: line-through;
        }

        .sg-product-footer {
            padding: 0 14px 14px;
        }

        .sg-add-to-cart {
            width: 100%;
            padding: 9px;
            background: var(--purple-50);
            color: var(--purple-800);
            border: 1px solid var(--purple-100);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
        }

        .sg-add-to-cart:hover {
            background: var(--purple-800);
            color: #fff;
            border-color: var(--purple-800);
        }

        /* ── Categories ── */
        .sg-categories-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
        }

        .sg-category-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 14px;
            padding: 20px 12px;
            text-align: center;
            text-decoration: none;
            transition: all 0.18s;
            font-family: 'DM Sans', sans-serif;
        }

        .sg-category-card:hover {
            border-color: var(--purple-200);
            background: var(--purple-50);
            transform: translateY(-2px);
        }

        .sg-category-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--gray-50);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 22px;
            transition: background 0.18s;
        }

        .sg-category-card:hover .sg-category-icon {
            background: var(--purple-100);
        }

        .sg-category-name {
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
        }

        /* ── Section wrapper ── */
        .sg-section {
            padding: 48px 0;
        }

        .sg-section-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 48px;
        }

        .sg-section-alt {
            background: var(--gray-50);
        }

        /* ── Mobile promo bar ── */
        .sg-promo-bar {
            background: var(--purple-50);
            border-bottom: 1px solid var(--purple-100);
            text-align: center;
            padding: 8px 20px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            color: var(--purple-800);
        }

        .sg-promo-bar strong {
            font-weight: 500;
        }

        /* ── Footer ── */
        footer.main {
            font-family: 'DM Sans', sans-serif;
        }

        /* ── Responsive ── */
        @media (max-width: 1024px) {
            .sg-product-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .sg-categories-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @media (max-width: 768px) {
            .sg-header-inner {
                padding: 0 20px;
            }

            .sg-search {
                display: none;
            }

            .sg-nav {
                display: none;
            }

            .sg-navbar {
                display: none;
            }

            .sg-hero-inner {
                grid-template-columns: 1fr;
            }

            .sg-hero-side {
                flex-direction: row;
            }

            .sg-product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .sg-categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .sg-section-inner {
                padding: 0 20px;
            }

            .sg-page-offset {
                padding-top: 64px;
            }
        }

        /* ── Tab content toggle ── */
        .sg-tab-pane {
            display: none;
        }

        .sg-tab-pane.active {
            display: block;
        }

        /* ── Fade-in animation ── */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sg-hero,
        .sg-section {
            animation: fadeUp 0.5s ease both;
        }
    </style>
</head>
