        // ── Tab switching ──
        function switchTab(e, tabId) {
            if (e && e.preventDefault) e.preventDefault();
            document.querySelectorAll('.sg-sidebar-nav a').forEach(a => a.classList.remove('active'));
            if (e && e.currentTarget) e.currentTarget.classList.add('active');
            document.querySelectorAll('.sg-tab-pane').forEach(p => p.classList.remove('active'));
            const pane = document.getElementById(tabId);
            if (pane) pane.classList.add('active');
        }

        // ── Activate tab from URL ──
        function activateTabFromURL() {
            const tabParam = new URLSearchParams(window.location.search).get('tab');
            const map = {
                'dashboard': 'tab-info',
                'address': 'tab-address',
                'orders': 'tab-orders',
                'track-orders': 'tab-track',
                'wallet': 'tab-wallet'
            };
            if (tabParam && map[tabParam]) {
                document.querySelectorAll('.sg-tab-pane').forEach(p => p.classList.remove('active'));
                document.getElementById(map[tabParam]).classList.add('active');
                document.querySelectorAll('.sg-sidebar-nav a').forEach(a => {
                    a.classList.remove('active');
                    if (a.getAttribute('onclick') && a.getAttribute('onclick').includes(map[tabParam])) {
                        a.classList.add('active');
                    }
                });
            }
        }

        document.addEventListener('DOMContentLoaded', activateTabFromURL);

