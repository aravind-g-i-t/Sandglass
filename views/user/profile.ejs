                        <input id="swal-billing_address2" class="swal2-input" placeholder="Address line 2" value="${addressLine2}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                        <input id="swal-city" class="swal2-input" placeholder="City *" value="${city}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                        <input id="swal-state" class="swal2-input" placeholder="State *" value="${state}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                        <input id="swal-pincode" class="swal2-input" placeholder="Pincode *" value="${pincode}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                        <input id="swal-phone" class="swal2-input" placeholder="Phone *" value="${phoneNo}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                        <input id="swal-email" class="swal2-input" placeholder="Email *" value="${email}" style="font-family:'DM Sans',sans-serif; font-size:13px;">
                    </div>`,
                focusConfirm: false,
                confirmButtonText: 'Save Changes',
                confirmButtonColor: '#3C3489',
                showCancelButton: true,
                cancelButtonColor: '#EEECE8',
                preConfirm: () => ({
                    fullName: document.getElementById('swal-fullName').value,
                    addressLine1: document.getElementById('swal-billing_address1').value,
                    addressLine2: document.getElementById('swal-billing_address2').value,
                    city: document.getElementById('swal-city').value,
                    state: document.getElementById('swal-state').value,
                    pincode: document.getElementById('swal-pincode').value,
                    phone: document.getElementById('swal-phone').value,
                    email: document.getElementById('swal-email').value,
                })
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const res = await fetch('/edit_address', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
