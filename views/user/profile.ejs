<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Profile</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">

    <style>
        /* ── Reset & tokens (match home page exactly) ── */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #2D9E6B;
            --warning: #D97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--gray-50);
            color: var(--gray-900);
            margin: 0;
        }

        /* ── Hide original header ── */
        .header-area {
            display: none !important;
        }

        /* ── Sandglass Header (identical to home) ── */
        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-nav {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sg-nav a {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-600);
            text-decoration: none;
            transition: color 0.15s;
        }

        .sg-nav a:hover {
            color: var(--purple-800);
        }

        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s, border-color 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            border-color: var(--gray-200);
            color: var(--gray-900);
        }

        .sg-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            width: 18px;
            height: 18px;
            background: var(--purple-800);
            color: #fff;
            border-radius: 50%;
            font-size: 10px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: 12px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(60,52,137,0.10);
    display: none;
    z-index: 200;
}

.sg-dropdown.active {
    display: block;
}


        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
            transition: background 0.12s;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown a.danger {
            color: var(--danger);
        }

        .sg-dropdown a.danger:hover {
            background: var(--danger-bg);
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        /* ── Navbar ── */
        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
            letter-spacing: 0.01em;
        }

        .sg-navbar a:hover,
        .sg-navbar a.active {
            color: #fff;
        }

        /* ── Page offset ── */
        .sg-page-offset {
            padding-top: 110px;
        }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            padding: 20px 0 0;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-breadcrumb a {
            color: var(--gray-400);
            text-decoration: none;
        }

        .sg-breadcrumb a:hover {
            color: var(--purple-800);
        }

        .sg-breadcrumb span {
            margin: 0 8px;
        }

        /* ── Profile layout ── */
        .sg-profile-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 48px 64px;
        }

        .sg-profile-header {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 32px 0 28px;
        }

        .sg-profile-avatar {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--purple-800);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 24px;
            color: #fff;
            flex-shrink: 0;
        }

        .sg-profile-header-text h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 26px;
            font-weight: 400;
            color: var(--gray-900);
            margin: 0 0 4px;
        }

        .sg-profile-header-text p {
            font-size: 13px;
            color: var(--gray-400);
            margin: 0;
        }

        .sg-profile-grid {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 24px;
            align-items: start;
        }

        /* ── Sidebar ── */
        .sg-sidebar {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            position: sticky;
            top: 126px;
        }

        .sg-sidebar-nav {
            list-style: none;
            margin: 0;
            padding: 8px;
        }

        .sg-sidebar-nav li {
            margin: 0;
        }

        .sg-sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            text-decoration: none;
            border-radius: 10px;
            transition: background 0.15s, color 0.15s;
            cursor: pointer;
        }

        .sg-sidebar-nav a:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-sidebar-nav a.active {
            background: var(--purple-50);
            color: var(--purple-800);
        }

        .sg-sidebar-nav a.danger {
            color: var(--danger);
        }

        .sg-sidebar-nav a.danger:hover {
            background: var(--danger-bg);
        }

        .sg-sidebar-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 8px;
        }

        /* ── Tab content ── */
        .sg-tab-content {
            min-height: 400px;
        }

        .sg-tab-pane {
            display: none;
        }

        .sg-tab-pane.active {
            display: block;
        }

        /* ── Card ── */
        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
        }

        .sg-card+.sg-card {
            margin-top: 20px;
        }

        .sg-card-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sg-card-header h5 {
            font-family: 'DM Serif Display', serif;
            font-size: 18px;
            font-weight: 400;
            color: var(--gray-900);
            margin: 0;
        }

        .sg-card-body {
            padding: 24px;
        }

        /* ── Info rows ── */
        .sg-info-row {
            display: flex;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid var(--gray-100);
            gap: 12px;
        }

        .sg-info-row:last-child {
            border-bottom: none;
        }

        .sg-info-label {
            font-size: 12px;
            font-weight: 500;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            width: 120px;
            flex-shrink: 0;
        }

        .sg-info-value {
            font-size: 14px;
            color: var(--gray-900);
            flex: 1;
        }

        .sg-edit-link {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-400);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.15s;
        }

        .sg-edit-link:hover {
            background: var(--purple-50);
            border-color: var(--purple-200);
            color: var(--purple-800);
        }

        /* ── Buttons ── */
        .sg-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid transparent;
            transition: all 0.15s;
        }

        .sg-btn-primary {
            background: var(--purple-800);
            color: #fff;
            border-color: var(--purple-800);
        }

        .sg-btn-primary:hover {
            background: var(--purple-900);
            border-color: var(--purple-900);
            color: #fff;
        }

        .sg-btn-outline {
            background: var(--white);
            color: var(--purple-800);
            border-color: var(--purple-200);
        }

        .sg-btn-outline:hover {
            background: var(--purple-50);
        }

        .sg-btn-danger {
            background: var(--white);
            color: var(--danger);
            border-color: #F5C6C6;
        }

        .sg-btn-danger:hover {
            background: var(--danger-bg);
            border-color: var(--danger);
        }

        .sg-btn-sm {
            padding: 6px 12px;
            font-size: 12px;
        }

        /* ── Orders table ── */
        .sg-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .sg-table thead th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 500;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-table thead th:first-child {
            border-radius: 8px 0 0 0;
        }

        .sg-table thead th:last-child {
            border-radius: 0 8px 0 0;
        }

        .sg-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--gray-100);
            color: var(--gray-900);
            vertical-align: middle;
        }

        .sg-table tbody tr:last-child td {
            border-bottom: none;
        }

        .sg-table tbody tr:hover td {
            background: var(--gray-50);
        }

        /* ── Badges ── */
        .sg-badge-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }

        .sg-badge-pending {
            background: #FEF3C7;
            color: var(--warning);
        }

        .sg-badge-processing {
            background: var(--purple-50);
            color: var(--purple-800);
        }

        .sg-badge-shipped {
            background: #DBEAFE;
            color: #1D4ED8;
        }

        .sg-badge-delivered {
            background: #D1FAE5;
            color: var(--success);
        }

        .sg-badge-cancelled {
            background: var(--gray-100);
            color: var(--gray-400);
        }

        .sg-badge-returned {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .sg-badge-info {
            background: var(--purple-50);
            color: var(--purple-800);
        }

        /* ── Collapsible order products ── */
        .sg-collapse {
            display: none;
        }

        .sg-collapse.open {
            display: table-row;
        }

        .sg-expand-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--purple-600);
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 0;
        }

        .sg-expand-btn svg {
            transition: transform 0.2s;
        }

        .sg-expand-btn.open svg {
            transform: rotate(180deg);
        }

        .sg-sub-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .sg-sub-table th {
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 500;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-sub-table td {
            padding: 10px 12px;
            color: var(--gray-900);
            border-bottom: 1px solid var(--gray-100);
            vertical-align: middle;
        }

        .sg-sub-table tr:last-child td {
            border-bottom: none;
        }

        /* ── Address cards ── */
        .sg-address-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .sg-address-card {
            border: 1px solid var(--gray-100);
            border-radius: 12px;
            padding: 18px;
            background: var(--white);
            transition: border-color 0.15s;
        }

        .sg-address-card:hover {
            border-color: var(--purple-200);
        }

        .sg-address-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            margin-bottom: 8px;
        }

        .sg-address-text {
            font-size: 13px;
            color: var(--gray-600);
            line-height: 1.6;
            margin-bottom: 14px;
        }

        .sg-address-actions {
            display: flex;
            gap: 8px;
        }

        /* ── Wallet ── */
        .sg-wallet-balance {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 28px;
            background: linear-gradient(135deg, var(--purple-800) 0%, var(--purple-900) 100%);
            border-radius: 14px;
            margin-bottom: 24px;
        }

        .sg-wallet-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sg-wallet-info span {
            font-size: 12px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.6);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            display: block;
            margin-bottom: 4px;
        }

        .sg-wallet-amount {
            font-family: 'DM Serif Display', serif;
            font-size: 36px;
            font-weight: 400;
            color: #fff;
            line-height: 1;
        }

        /* ── Track order form ── */
        .sg-form-group {
            margin-bottom: 16px;
        }

        .sg-form-group label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 6px;
        }

        .sg-input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            background: var(--white);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-input::placeholder {
            color: var(--gray-200);
        }

        /* ── Modal (matching design) ── */
        .sg-modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(26, 25, 24, 0.45);
            backdrop-filter: blur(4px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .sg-modal-backdrop.open {
            display: flex;
        }

        .sg-modal {
            background: var(--white);
            border-radius: 16px;
            width: 100%;
            max-width: 440px;
            margin: 20px;
            box-shadow: 0 24px 60px rgba(60, 52, 137, 0.15);
            animation: modalIn 0.2s ease;
        }

        @keyframes modalIn {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .sg-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-modal-header h5 {
            font-family: 'DM Serif Display', serif;
            font-size: 18px;
            font-weight: 400;
            margin: 0;
            color: var(--gray-900);
        }

        .sg-modal-close {
            width: 28px;
            height: 28px;
            border: 1px solid var(--gray-100);
            border-radius: 6px;
            background: var(--white);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-400);
            transition: all 0.15s;
        }

        .sg-modal-close:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-modal-body {
            padding: 24px;
        }

        .sg-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 16px 24px;
            border-top: 1px solid var(--gray-100);
        }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .sg-header-inner {
                padding: 0 20px;
            }

            .sg-nav {
                display: none;
            }

            .sg-navbar {
                display: none;
            }

            .sg-profile-wrap {
                padding: 0 20px 48px;
            }

            .sg-profile-grid {
                grid-template-columns: 1fr;
            }

            .sg-address-grid {
                grid-template-columns: 1fr;
            }

            .sg-sidebar {
                position: static;
            }

            .credit {
                font-weight: 500;
                color: var(--success);
            }

            .debit {
                font-weight: 500;
                color: var(--danger);
            }
        }

        /* ── Fade-in ── */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sg-tab-pane.active {
            animation: fadeUp 0.25s ease both;
        }
    </style>
</head>

