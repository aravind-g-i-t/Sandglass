<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Create Account</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --purple-50:  #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50:  #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white:    #FFFFFF;
            --danger:    #E24B4A;
            --danger-bg: #FCEBEB;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: rgba(255,255,255,0.90);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 40px;
            display: flex;
            align-items: center;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 30px; height: 30px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 19px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        /* ── Page ── */
        .sg-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 40px 60px;
            background:
                radial-gradient(ellipse 55% 45% at 85% 15%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 8%  85%, var(--purple-100) 0%, transparent 60%),
                var(--gray-50);
        }

        /* ── Card ── */
        .sg-card-wrap {
            width: 100%;
            max-width: 680px;
        }

        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 56px 64px;
            box-shadow: 0 4px 32px rgba(60,52,137,0.08), 0 1px 4px rgba(0,0,0,0.04);
            animation: fadeUp 0.4s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .sg-title {
            font-family: 'DM Serif Display', serif;
            font-size: 30px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .sg-subtitle {
            font-size: 15px;
            color: var(--gray-400);
            margin-bottom: 36px;
        }

        /* ── Alert ── */
        .alert-danger {
            background: var(--danger-bg);
            border: 1px solid #F7C1C1;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            color: var(--danger);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Fields grid ── */
        .sg-fields {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 24px;
        }

        .sg-field {
            margin-bottom: 20px;
        }

        .sg-field-full {
            grid-column: 1 / -1;
        }

        .sg-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            margin-bottom: 7px;
            display: block;
        }

        .sg-input-wrap {
            position: relative;
        }

        .sg-input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-200);
            pointer-events: none;
            display: flex;
        }

        .sg-input-wrap input {
            width: 100%;
            padding: 11px 13px 11px 40px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            transition: border-color 0.15s, box-shadow 0.15s;
            outline: none;
        }

        .sg-input-wrap input::placeholder {
            color: var(--gray-200);
        }

        .sg-input-wrap input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .error {
            font-size: 12px;
            color: var(--danger);
            margin-top: 5px;
            min-height: 16px;
            display: block;
        }

        /* ── Terms row ── */
        .sg-terms-row {
            margin-bottom: 28px;
        }

        .sg-check-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-check-wrap input[type=checkbox] {
            width: 15px; height: 15px;
            accent-color: var(--purple-800);
            cursor: pointer;
            flex-shrink: 0;
        }

        .sg-check-wrap label {
            font-size: 13px;
            color: var(--gray-600);
            cursor: pointer;
        }

        .sg-check-wrap label a {
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-check-wrap label a:hover { text-decoration: underline; }

        /* ── Submit button ── */
        .sg-btn-primary {
            width: 100%;
            padding: 12px 16px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .sg-btn-primary:hover { background: var(--purple-900); }
        .sg-btn-primary:active { transform: scale(0.98); }

        /* ── Sign-in link ── */
        .sg-signin {
            text-align: center;
            margin-top: 28px;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-signin a {
            color: var(--purple-600);
            font-weight: 500;
            text-decoration: none;
        }

        .sg-signin a:hover { text-decoration: underline; }

        .sg-page-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 12px;
        }

        /* ── Responsive ── */
        @media (max-width: 600px) {
            .sg-page  { padding: 90px 20px 40px; }
            .sg-card  { padding: 36px 24px; }
            .sg-fields { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>

    <header class="sg-header">
        <a href="/" class="sg-logo">
            <div class="sg-logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                </svg>
            </div>
            <span class="sg-logo-text">Sandglass</span>
        </a>
    </header>

    <div class="sg-page">
        <div class="sg-card-wrap">
            <div class="sg-card">
                <p class="sg-eyebrow">Get started</p>
                <h1 class="sg-title">Create your account</h1>
                <p class="sg-subtitle">Fill in your details to get started with Sandglass</p>

                <% if(locals.message) { %>
                <div class="alert alert-danger" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <%= message %>
                </div>
                <% } %>

                <form id="registrationForm" method="post" novalidate>
                    <div class="sg-fields">

                        <!-- Username -->
                        <div class="sg-field">
                            <label class="sg-label" for="username">Username</label>
                            <div class="sg-input-wrap">
                                <span class="sg-input-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                                </span>
                                <input type="text" id="username" name="username" placeholder="johndoe" class="form-control" required>
                            </div>
                            <span class="error" id="usernameError"></span>
                        </div>

                        <!-- Email -->
                        <div class="sg-field">
                            <label class="sg-label" for="email">Email address</label>
                            <div class="sg-input-wrap">
                                <span class="sg-input-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
                                </span>
                                <input type="email" id="email" name="email" placeholder="you@example.com" class="form-control" required>
                            </div>
                            <span class="error" id="emailError"></span>
                        </div>

                        <!-- Phone -->
                        <div class="sg-field">
                            <label class="sg-label" for="phone">Phone number</label>
                            <div class="sg-input-wrap">
                                <span class="sg-input-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 .92h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                                </span>
                                <input type="tel" id="phone" name="phone" placeholder="10-digit number" class="form-control" required>
                            </div>
                            <span class="error" id="phoneError"></span>
                        </div>

                        <!-- Password -->
                        <div class="sg-field">
                            <label class="sg-label" for="password">Password</label>
                            <div class="sg-input-wrap">
                                <span class="sg-input-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                </span>
                                <input type="password" id="password" name="password" placeholder="Min. 6 characters" class="form-control" required minlength="6">
                            </div>
                            <span class="error" id="passwordError"></span>
                        </div>

                    </div>

                    <!-- Terms -->
                    <div class="sg-terms-row">
                        <div class="sg-check-wrap">
                            <input type="checkbox" id="termsCheckbox" name="checkbox" required>
                            <label for="termsCheckbox">I agree to the <a href="#">Terms &amp; Policy</a></label>
                        </div>
                        <span class="error" id="termsError"></span>
                    </div>

                    <button class="sg-btn-primary" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                        Create account
                    </button>
                </form>

                <div class="sg-signin">
                    Already have an account? <a href="/login">Sign in</a>
                </div>
            </div>

            <p class="sg-page-footer">© 2026 Sandglass. All rights reserved.</p>
        </div>
    </div>

    <script>
        document.getElementById('registrationForm').addEventListener('submit', function(event) {
            let valid = true;

            document.getElementById('usernameError').textContent = '';
            document.getElementById('emailError').textContent = '';
            document.getElementById('phoneError').textContent = '';
            document.getElementById('passwordError').textContent = '';
            document.getElementById('termsError').textContent = '';

            const username = document.getElementById('username');
            if (!username.value) {
                document.getElementById('usernameError').textContent = 'Username is required.';
                valid = false;
            }

            const email = document.getElementById('email');
            if (!email.value) {
                document.getElementById('emailError').textContent = 'Email is required.';
                valid = false;
            } else if (!email.validity.valid) {
                document.getElementById('emailError').textContent = 'Please enter a valid email address.';
                valid = false;
            }

            const phone = document.getElementById('phone');
            const phonePattern = /^[0-9]{10}$/;
            if (!phone.value) {
                document.getElementById('phoneError').textContent = 'Phone number is required.';
                valid = false;
            } else if (!phonePattern.test(phone.value)) {
                document.getElementById('phoneError').textContent = 'Please enter a valid 10-digit phone number.';
                valid = false;
            }

            const password = document.getElementById('password');
            if (!password.value) {
                document.getElementById('passwordError').textContent = 'Password is required.';
                valid = false;
            } else if (password.value.length < 6) {
                document.getElementById('passwordError').textContent = 'Password must be at least 6 characters long.';
                valid = false;
            }

            const termsCheckbox = document.getElementById('termsCheckbox');
            if (!termsCheckbox.checked) {
                document.getElementById('termsError').textContent = 'You must agree to the terms & policy.';
                valid = false;
            }

            if (!valid) {
                event.preventDefault();
            }
        });
    </script>

</body>
</html>