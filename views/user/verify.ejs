<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — OTP Verification</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <link rel="shortcut icon" type="image/x-icon" href="/user/assets/imgs/theme/favicon.svg">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --purple-50:  #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50:  #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white:    #FFFFFF;
            --danger:    #E24B4A;
            --danger-bg: #FCEBEB;
            --success:   #3B6D11;
            --success-bg:#EAF3DE;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
        }

        /* ── Header ── */
        .sg-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: rgba(255,255,255,0.90);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 40px;
            display: flex;
            align-items: center;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 30px; height: 30px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 19px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        /* ── Page ── */
        .sg-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 40px 60px;
            background:
                radial-gradient(ellipse 55% 45% at 85% 15%, var(--purple-50) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 8%  85%, var(--purple-100) 0%, transparent 60%),
                var(--gray-50);
        }

        /* ── Card ── */
        .sg-card-wrap {
            width: 100%;
            max-width: 480px;
        }

        .sg-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 20px;
            padding: 48px 52px;
            box-shadow: 0 4px 32px rgba(60,52,137,0.08), 0 1px 4px rgba(0,0,0,0.04);
            animation: fadeUp 0.4s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Icon badge ── */
        .sg-icon-badge {
            width: 52px; height: 52px;
            background: var(--purple-50);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 20px;
        }

        .sg-eyebrow {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--purple-600);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .sg-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--gray-900);
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .sg-subtitle {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 32px;
            line-height: 1.6;
        }

        /* ── Alerts ── */
        .sg-alert {
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-alert-danger {
            background: var(--danger-bg);
            border: 1px solid #F7C1C1;
            color: var(--danger);
        }

        .sg-alert-success {
            background: var(--success-bg);
            border: 1px solid #C0DD97;
            color: var(--success);
        }

        /* ── OTP input ── */
        .sg-field { margin-bottom: 20px; }

        .sg-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
            margin-bottom: 7px;
            display: block;
        }

        .sg-input-wrap { position: relative; }

        .sg-input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-200);
            pointer-events: none;
            display: flex;
        }

        .sg-input-wrap input {
            width: 100%;
            padding: 11px 13px 11px 40px;
            font-size: 15px;
            font-family: 'DM Sans', sans-serif;
            letter-spacing: 0.15em;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            transition: border-color 0.15s, box-shadow 0.15s;
            outline: none;
        }

        .sg-input-wrap input::placeholder {
            color: var(--gray-200);
            letter-spacing: 0;
        }

        .sg-input-wrap input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        /* ── Timer ── */
        .sg-timer {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--gray-400);
            margin-bottom: 28px;
        }

        .sg-timer span#countdown {
            font-weight: 500;
            color: var(--purple-600);
            font-variant-numeric: tabular-nums;
        }

        .sg-timer span#countdown.expired {
            color: var(--danger);
        }

        /* ── Submit button ── */
        .sg-btn-primary {
            width: 100%;
            padding: 12px 16px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
            margin-bottom: 20px;
        }

        .sg-btn-primary:hover  { background: var(--purple-900); }
        .sg-btn-primary:active { transform: scale(0.98); }
        .sg-btn-primary:disabled {
            background: var(--gray-200);
            color: var(--gray-400);
            cursor: not-allowed;
        }

        /* ── Resend ── */
        .sg-resend {
            text-align: center;
            font-size: 13px;
            color: var(--gray-400);
        }

        .sg-resend a {
            color: var(--purple-600);
            font-weight: 500;
            text-decoration: none;
        }

        .sg-resend a:hover { text-decoration: underline; }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--gray-400);
            margin-bottom: 24px;
        }

        .sg-breadcrumb a {
            color: var(--purple-600);
            text-decoration: none;
            font-weight: 500;
        }

        .sg-breadcrumb a:hover { text-decoration: underline; }

        .sg-breadcrumb-sep {
            color: var(--gray-200);
        }

        .sg-page-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 12px;
        }

        /* ── Responsive ── */
        @media (max-width: 600px) {
            .sg-header { padding: 14px 20px; }
            .sg-page   { padding: 90px 20px 40px; }
            .sg-card   { padding: 32px 24px; }
        }
    </style>
</head>

<body>

    <!-- ── Header ── -->
    <header class="sg-header">
        <a href="/" class="sg-logo">
            <div class="sg-logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                </svg>
            </div>
            <span class="sg-logo-text">Sandglass</span>
        </a>
    </header>

    <!-- ── Page ── -->
    <div class="sg-page">
        <div class="sg-card-wrap">

            <!-- Breadcrumb -->
            <div class="sg-breadcrumb">
                <a href="/login">Login</a>
                <span class="sg-breadcrumb-sep">/</span>
                <a href="/signup">Register</a>
                <span class="sg-breadcrumb-sep">/</span>
                <span>OTP Verification</span>
            </div>

            <div class="sg-card">

                <!-- Icon + heading -->
                <div class="sg-icon-badge">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#534AB7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="m22 7-10 7L2 7"/>
                    </svg>
                </div>

                <p class="sg-eyebrow">Verification</p>
                <h1 class="sg-title">Check your email</h1>
                <p class="sg-subtitle">We've sent a one-time passcode to your registered email address. Enter it below to continue.</p>

                <!-- Server-side error -->
                <% if(locals.message) { %>
                <div class="sg-alert sg-alert-danger" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <%= message %>
                </div>
                <% } %>

                <!-- Client-side feedback -->
                <div class="sg-alert sg-alert-danger" id="jsError" style="display:none" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span id="jsErrorText"></span>
                </div>

                <div class="sg-alert sg-alert-success" id="jsSuccess" style="display:none" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span id="jsSuccessText"></span>
                </div>

                <form id="otpForm" method="post">
                    <div class="sg-field">
                        <label class="sg-label" for="otp">One-time passcode</label>
                        <div class="sg-input-wrap">
                            <span class="sg-input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                            </span>
                            <input type="text" id="otp" name="otp" placeholder="Enter OTP" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required>
                        </div>
                    </div>

                    <!-- Timer -->
                    <div class="sg-timer">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Time remaining: <span id="countdown">05:00</span>
                    </div>

                    <button class="sg-btn-primary" type="submit" id="verifyBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Verify OTP
                    </button>
                </form>

                <div class="sg-resend">
                    Didn't receive the code? <a href="/resend_otp">Resend OTP</a>
                </div>

            </div>

            <p class="sg-page-footer">© <script>document.write(new Date().getFullYear())</script> Sandglass. All rights reserved.</p>
        </div>
    </div>

    <script>
        // ── Timer ──
        let countdown = 300;
        const countdownEl = document.getElementById('countdown');
        const verifyBtn   = document.getElementById('verifyBtn');

        function formatTime(s) {
            const m = Math.floor(s / 60);
            const sec = s % 60;
            return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
        }

        const timer = setInterval(() => {
            countdown--;
            countdownEl.textContent = formatTime(countdown);
            if (countdown <= 0) {
                clearInterval(timer);
                countdownEl.classList.add('expired');
                countdownEl.textContent = 'Expired';
                verifyBtn.disabled = true;
                showError('OTP has expired. Please request a new one.');
            }
        }, 1000);

        // ── Client-side validation ──
        function showError(msg) {
            const el = document.getElementById('jsError');
            document.getElementById('jsErrorText').textContent = msg;
            el.style.display = 'flex';
            document.getElementById('jsSuccess').style.display = 'none';
        }

        document.getElementById('otpForm').addEventListener('submit', function(e) {
            const otp = document.getElementById('otp').value.trim();
            if (!otp) {
                e.preventDefault();
                showError('Please enter the OTP before submitting.');
                return;
            }
            if (!/^\d{4,6}$/.test(otp)) {
                e.preventDefault();
                showError('OTP must be a 4–6 digit number.');
            }
        });
    </script>

    <script src="/user/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="/user/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="/user/assets/js/main.js?v=3.4"></script>

</body>
</html>

