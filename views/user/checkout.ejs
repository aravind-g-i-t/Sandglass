<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Checkout</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --purple-50:  #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50:  #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
            --success: #1D9E75;
            --success-bg: #E8F8F2;
        }

        /* hide original header */
        .header-area { display: none !important; }

        html, body {
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
            background: var(--gray-50);
        }

        /* ── Sandglass Header ── */
        .sg-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1050;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .sg-logo-icon {
            width: 32px; height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
        }

        .sg-search {
            position: relative;
            flex: 0 0 220px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder { color: var(--gray-200); }

        .sg-search-icon {
            position: absolute;
            left: 10px; top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            pointer-events: none;
        }

        .sg-header-actions { display: flex; align-items: center; gap: 8px; }

        .sg-icon-btn {
            width: 38px; height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex; align-items: center; justify-content: center;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s;
        }

        .sg-icon-btn:hover { background: var(--gray-50); color: var(--gray-900); }

        

        .sg-user-wrap { position: relative; }

        .sg-user-btn {
            display: flex; align-items: center; gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px; font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover { background: var(--gray-50); color: var(--gray-900); }

        .sg-user-avatar {
            width: 26px; height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: 12px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(60,52,137,0.10);
    display: none;
    z-index: 200;
}

.sg-dropdown.active {
    display: block;
}


        .sg-dropdown a {
            display: flex; align-items: center; gap: 8px;
            padding: 9px 12px; font-size: 13px;
            color: var(--gray-900); text-decoration: none;
            border-radius: 8px; transition: background 0.12s;
        }

        .sg-dropdown a:hover { background: var(--gray-50); }
        .sg-dropdown a.danger { color: var(--danger); }
        .sg-dropdown a.danger:hover { background: var(--danger-bg); }
        .sg-dropdown-divider { height: 1px; background: var(--gray-100); margin: 4px 0; }

        /* ── Navbar ── */
        .sg-navbar {
            position: fixed;
            top: 64px; left: 0; right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex; align-items: center; justify-content: center;
            gap: 40px; padding: 0 48px; height: 46px;
        }

        .sg-navbar a {
            font-size: 13px; font-weight: 500;
            color: rgba(255,255,255,0.75);
            text-decoration: none; transition: color 0.15s;
        }

        .sg-navbar a:hover, .sg-navbar a.active { color: #fff; }

        /* ── Page offset ── */
        .sg-offset { padding-top: 110px; }

        /* ── Breadcrumb ── */
        .sg-breadcrumb {
            background: var(--white);
            border-bottom: 1px solid var(--gray-100);
            padding: 14px 0;
            font-size: 13px; color: var(--gray-400);
        }

        .sg-breadcrumb .container { display: flex; align-items: center; gap: 8px; }
        .sg-breadcrumb a { color: var(--purple-600); text-decoration: none; font-weight: 500; }
        .sg-breadcrumb a:hover { text-decoration: underline; }
        .sg-breadcrumb .bc-sep { color: var(--gray-200); }
        .sg-breadcrumb .bc-current { color: var(--gray-900); font-weight: 500; }

        /* ── Checkout steps indicator ── */
        .sg-steps {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            padding: 28px 0 0;
            margin-bottom: 36px;
        }

        .sg-step {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-400);
        }

        .sg-step.active { color: var(--purple-800); }
        .sg-step.done { color: var(--success); }

        .sg-step-num {
            width: 28px; height: 28px;
            border-radius: 50%;
            border: 2px solid var(--gray-200);
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 600;
            background: var(--white);
        }

        .sg-step.active .sg-step-num {
            border-color: var(--purple-800);
            background: var(--purple-800);
            color: #fff;
        }

        .sg-step.done .sg-step-num {
            border-color: var(--success);
            background: var(--success);
            color: #fff;
        }

        .sg-step-connector {
            width: 60px; height: 2px;
            background: var(--gray-100);
            margin: 0 8px;
        }

        /* ── Section heading ── */
        .sg-section-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .sg-section-head h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            font-weight: 400;
            color: var(--gray-900);
            margin: 0;
        }

        /* ── Cart items table ── */
        .sg-cart-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .sg-cart-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .sg-cart-table thead {
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-cart-table thead th {
            padding: 14px 20px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--gray-400);
            text-align: left;
        }

        .sg-cart-table tbody tr {
            border-bottom: 1px solid var(--gray-100);
            transition: background 0.12s;
        }

        .sg-cart-table tbody tr:last-child { border-bottom: none; }
        .sg-cart-table tbody tr:hover { background: var(--gray-50); }

        .sg-cart-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
            color: var(--gray-900);
        }

        .sg-cart-product {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .sg-cart-img {
            width: 56px; height: 56px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--gray-100);
            flex-shrink: 0;
        }

        .sg-cart-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
        }

        .sg-qty-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px; height: 28px;
            border-radius: 6px;
            background: var(--gray-50);
            border: 1px solid var(--gray-100);
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
        }

        /* ── Address cards ── */
        .sg-addresses { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }

        .sg-address-card {
            background: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: 14px;
            padding: 18px 20px;
            cursor: pointer;
            transition: border-color 0.15s, box-shadow 0.15s;
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .sg-address-card:has(input:checked),
        .sg-address-card.selected {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-address-card input[type="radio"] {
            width: 16px; height: 16px;
            accent-color: var(--purple-800);
            flex-shrink: 0;
            margin-top: 3px;
            cursor: pointer;
        }

        .sg-address-details { font-size: 13px; color: var(--gray-600); line-height: 1.7; }
        .sg-address-name { font-size: 14px; font-weight: 500; color: var(--gray-900); margin-bottom: 4px; }

        /* ── New address form ── */
        .sg-form-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            padding: 28px 32px;
            margin-top: 20px;
        }

        .sg-form-card h4 {
            font-family: 'DM Serif Display', serif;
            font-size: 18px; font-weight: 400;
            color: var(--gray-900); margin-bottom: 20px;
        }

        .sg-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .sg-form-full { grid-column: 1 / -1; }
        .sg-form-group { display: flex; flex-direction: column; gap: 7px; }

        .sg-form-group label {
            font-size: 13px; font-weight: 500; color: var(--gray-600);
        }

        .sg-form-group input {
            padding: 10px 14px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--white);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-form-group input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-form-group input::placeholder { color: var(--gray-200); }

        .sg-form-actions { display: flex; gap: 10px; margin-top: 20px; }

        .sg-btn-save {
            padding: 10px 20px;
            background: var(--purple-800); color: #fff;
            border: none; border-radius: 8px;
            font-size: 14px; font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer; transition: background 0.15s;
        }

        .sg-btn-save:hover { background: var(--purple-900); }

        .sg-btn-cancel {
            padding: 10px 20px;
            background: var(--white); color: var(--gray-600);
            border: 1px solid var(--gray-200); border-radius: 8px;
            font-size: 14px; font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer; transition: background 0.15s;
        }

        .sg-btn-cancel:hover { background: var(--gray-50); }

        .sg-btn-add-address {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 16px;
            border: 1px dashed var(--purple-200);
            border-radius: 10px;
            background: var(--purple-50);
            color: var(--purple-600);
            font-size: 13px; font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer; transition: all 0.15s;
        }

        .sg-btn-add-address:hover { border-color: var(--purple-400); background: var(--purple-100); }

        /* ── Order summary ── */
        .sg-summary-card {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            padding: 28px;
            position: sticky;
            top: 120px;
        }

        .sg-summary-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 20px; font-weight: 400;
            color: var(--gray-900); margin-bottom: 20px;
        }

        .sg-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            color: var(--gray-600);
            padding: 8px 0;
        }

        .sg-summary-row.discount { color: var(--success); }
        .sg-summary-divider { height: 1px; background: var(--gray-100); margin: 10px 0; }

        .sg-summary-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0 0;
        }

        .sg-summary-total span:first-child {
            font-size: 15px; font-weight: 500; color: var(--gray-900);
        }

        .sg-summary-total-price {
            font-family: 'DM Serif Display', serif;
            font-size: 24px; color: var(--purple-800);
        }

        /* ── Payment options ── */
        .sg-payment-options { display: flex; flex-direction: column; gap: 10px; margin: 20px 0; }

        .sg-payment-option {
            display: flex; align-items: center; gap: 14px;
            padding: 14px 16px;
            border: 1px solid var(--gray-200);
            border-radius: 10px;
            cursor: pointer;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-payment-option:has(input:checked) {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
        }

        .sg-payment-option input[type="radio"] {
            width: 16px; height: 16px;
            accent-color: var(--purple-800);
            cursor: pointer;
            flex-shrink: 0;
        }

        .sg-payment-option-info { flex: 1; }

        .sg-payment-label {
            font-size: 14px; font-weight: 500; color: var(--gray-900);
        }

        .sg-payment-desc {
            font-size: 12px; color: var(--gray-400); margin-top: 2px;
        }

        .sg-payment-icon {
            width: 36px; height: 36px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            display: flex; align-items: center; justify-content: center;
            color: var(--gray-600);
            background: var(--gray-50);
        }

        /* ── Place order button ── */
        .sg-btn-place-order {
            width: 100%;
            padding: 14px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px; font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: background 0.15s, transform 0.1s;
            margin-top: 8px;
        }

        .sg-btn-place-order:hover { background: var(--purple-900); }
        .sg-btn-place-order:active { transform: scale(0.99); }

        .sg-secure-note {
            display: flex; align-items: center; justify-content: center;
            gap: 6px;
            font-size: 12px; color: var(--gray-400);
            margin-top: 12px;
        }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .sg-header-inner { padding: 0 20px; }
            .sg-search { display: none; }
            .sg-navbar { display: none; }
            .sg-offset { padding-top: 64px; }
            .sg-form-grid { grid-template-columns: 1fr; }
            .sg-form-card { padding: 20px; }
            .sg-summary-card { position: static; }
        }
    </style>
</head>

<body>

    <!-- ── Sandglass Header ── -->
    <header class="sg-header">
        <div class="sg-header-inner">
            <a href="/" class="sg-logo">
                <div class="sg-logo-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                    </svg>
                </div>
                <span class="sg-logo-text">Sandglass</span>
            </a>

            <div class="sg-search">
                <span class="sg-search-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </span>
                <form action="/shop" method="get">
                    <input name="search" type="text" placeholder="Search for items…">
                </form>
            </div>

            <div class="sg-header-actions">
                <% if(userData) { %>
                    <a href="/wishlist" class="sg-icon-btn" title="Wishlist">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    </a>
                    <a href="/cart" class="sg-icon-btn" title="Cart">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                    </a>
                    <div class="sg-user-wrap">
                        <a href="#" id="userDropdownBtn" class="sg-user-btn">
                            <div class="sg-user-avatar"><%= userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %></div>
                            <%= userData.username %>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </a>
                        <div class="sg-dropdown">
                            <a href="/profile">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profile
                            </a>
                            <div class="sg-dropdown-divider"></div>
                            <a href="#" id="logoutBtn" class="danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                                Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="sg-user-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Log in
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- ── Navbar ── -->
    <nav class="sg-navbar">
        <a href="/">Home</a>
        <a href="/shop" class="active">Shop</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
    </nav>

    <div class="sg-offset"></div>

    <!-- ── Breadcrumb ── -->
    <div class="sg-breadcrumb">
        <div class="container">
            <a href="/">Home</a>
            <span class="bc-sep">›</span>
            <a href="/cart">Cart</a>
            <span class="bc-sep">›</span>
            <span class="bc-current">Checkout</span>
        </div>
    </div>

    <main class="main">
        <div class="container">

            <!-- ── Steps ── -->
            <div class="sg-steps">
                <div class="sg-step done">
                    <div class="sg-step-num">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    Cart
                </div>
                <div class="sg-step-connector"></div>
                <div class="sg-step active">
                    <div class="sg-step-num">2</div>
                    Checkout
                </div>
                <div class="sg-step-connector"></div>
                <div class="sg-step">
                    <div class="sg-step-num">3</div>
                    Confirmation
                </div>
            </div>

            <div class="row">
                <!-- ── Left column ── -->
                <div class="col-lg-7">

                    <!-- Cart items -->
                    <div class="sg-section-head">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--purple-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        <h3>Order Items</h3>
                    </div>

                    <% if(cartData) { %>
                    <div class="sg-cart-card">
                        <table class="sg-cart-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cartData.product.forEach(item => { %>
                                <tr>
                                    <td>
                                        <div class="sg-cart-product">
                                            <img src="/uploads/<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>" class="sg-cart-img">
                                            <span class="sg-cart-name"><%= item.productId.productName %></span>
                                        </div>
                                    </td>
                                    <td>₹<%= item.productPrice %></td>
                                    <td><span class="sg-qty-badge"><%= item.quantity %></span></td>
                                    <td style="font-weight:500;color:var(--purple-800)">₹<%= item.productPrice * item.quantity %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>

                    <!-- Delivery address -->
                    <div class="sg-section-head" style="margin-top:32px">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--purple-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <h3>Delivery Address</h3>
                    </div>

                    <% if(addressData) { %>
                    <div class="sg-addresses" id="saved-addresses">
                        <% addressData.address.forEach((data, index) => { %>
                        <label class="sg-address-card" for="address<%= index %>">
                            <input type="radio" name="address" id="address<%= index %>" value="<%= data._id %>" <%= index === 0 ? 'checked' : '' %>>
                            <div>
                                <p class="sg-address-name"><%= data.fullName %></p>
                                <div class="sg-address-details">
                                    <%= data.addressLine1 %><% if(data.addressLine2) { %>, <%= data.addressLine2 %><% } %><br>
                                    <%= data.city %>, <%= data.state %> – <%= data.pincode %><br>
                                    <span style="color:var(--gray-400)">📞 <%= data.phone %> &nbsp;·&nbsp; ✉ <%= data.email %></span>
                                </div>
                            </div>
                        </label>
                        <% }) %>
                    </div>
                    <% } %>

                    <button class="sg-btn-add-address" onclick="showNewAddressForm()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add new address
                    </button>

                    <!-- New address form -->
                    <div id="new-address-form" style="display:none;">
                        <div class="sg-form-card">
                            <h4>New delivery address</h4>
                            <form action="/checkout" method="post" id="address-form">
                                <div class="sg-form-grid">
                                    <div class="sg-form-group sg-form-full">
                                        <label for="fullName">Full name</label>
                                        <input name="fullName" type="text" id="fullName" placeholder="John Doe" pattern="[a-zA-Z\s.]+" title="Letters, spaces, or dots only" required>
                                    </div>
                                    <div class="sg-form-group sg-form-full">
                                        <label for="address1">Address line 1</label>
                                        <input name="addressLine1" type="text" id="address1" placeholder="Street address, P.O. box" required>
                                    </div>
                                    <div class="sg-form-group sg-form-full">
                                        <label for="address2">Address line 2 <span style="color:var(--gray-400);font-weight:400">(optional)</span></label>
                                        <input name="addressLine2" type="text" id="address2" placeholder="Apartment, suite, unit, etc.">
                                    </div>
                                    <div class="sg-form-group">
                                        <label for="city">City</label>
                                        <input name="city" type="text" id="city" placeholder="Mumbai" pattern="[a-zA-Z\s]+" title="Letters and spaces only" required>
                                    </div>
                                    <div class="sg-form-group">
                                        <label for="state">State</label>
                                        <input name="state" type="text" id="state" placeholder="Maharashtra" pattern="[a-zA-Z\s]+" title="Letters and spaces only" required>
                                    </div>
                                    <div class="sg-form-group">
                                        <label for="pincode">Pincode</label>
                                        <input name="pincode" type="text" id="pincode" placeholder="400001" pattern="\d{6}" title="6-digit pincode" required>
                                    </div>
                                    <div class="sg-form-group">
                                        <label for="phone">Phone number</label>
                                        <input name="phone" type="text" id="phone" placeholder="9876543210" pattern="\d{10}" title="10-digit number" required>
                                    </div>
                                    <div class="sg-form-group sg-form-full">
                                        <label for="email">Email</label>
                                        <input name="email" type="email" id="email" placeholder="you@example.com" required>
                                    </div>
                                </div>
                                <div class="sg-form-actions">
                                    <button type="button" class="sg-btn-save" onclick="validateAndSaveAddress()">Save address</button>
                                    <button type="button" class="sg-btn-cancel" onclick="cancelNewAddress()">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <!-- ── Right column: summary + payment ── -->
                <div class="col-lg-5 mt-4 mt-lg-0">
                    <div class="sg-summary-card">
                        <h3>Order Summary</h3>

                        <div class="sg-summary-row">
                            <span>Cart subtotal</span>
                            <span>₹<%= (totalPrice).toFixed(2) %></span>
                        </div>

                        <% if (cartData.coupon) { %>
                        <div class="sg-summary-row discount">
                            <span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><polyline points="20 6 9 17 4 12"/></svg>
                                Coupon (<%= cartData.coupon %>)
                            </span>
                            <span>−₹<%= (totalPrice * (couponDiscount / 100)).toFixed(2) %></span>
                        </div>
                        <% } %>

                        <div class="sg-summary-row">
                            <span>Shipping</span>
                            <span id="shipping-charge">₹300</span>
                        </div>

                        <div class="sg-summary-divider"></div>

                        <div class="sg-summary-total">
                            <span>Total payable</span>
                            <span class="sg-summary-total-price" id="total-payable">
                                ₹<%= (totalPrice - (cartData.coupon ? totalPrice * (couponDiscount / 100) : 0) + 300).toFixed(2) %>
                            </span>
                        </div>

                        <!-- Payment options -->
                        <p style="font-size:13px;font-weight:500;color:var(--gray-600);margin:24px 0 12px">Payment method</p>

                        <div class="sg-payment-options">
                            <% if(codApplicable) { %>
                            <label class="sg-payment-option">
                                <input type="radio" name="payment-method" id="cod" value="COD">
                                <div class="sg-payment-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                </div>
                                <div class="sg-payment-option-info">
                                    <div class="sg-payment-label">Cash on Delivery</div>
                                    <div class="sg-payment-desc">Pay when you receive</div>
                                </div>
                            </label>
                            <% } %>

                            <label class="sg-payment-option">
                                <input type="radio" name="payment-method" id="razorpay" value="RazorPay">
                                <div class="sg-payment-icon" style="background:#072654;border-color:#072654">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                </div>
                                <div class="sg-payment-option-info">
                                    <div class="sg-payment-label">Razorpay</div>
                                    <div class="sg-payment-desc">Cards, UPI, Net Banking & more</div>
                                </div>
                            </label>

                            <% if(walletApplicable) { %>
                            <label class="sg-payment-option">
                                <input type="radio" name="payment-method" id="wallet" value="Wallet">
                                <div class="sg-payment-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4a2 2 0 01-2-2V5a2 2 0 012-2h16v4"/><path d="M20 12a2 2 0 100 4 2 2 0 000-4z"/></svg>
                                </div>
                                <div class="sg-payment-option-info">
                                    <div class="sg-payment-label">Wallet</div>
                                    <div class="sg-payment-desc">Pay from your Sandglass wallet</div>
                                </div>
                            </label>
                            <% } %>
                        </div>

                        <button class="sg-btn-place-order" onclick="placeOrder()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            Place order
                        </button>

                        <p class="sg-secure-note">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            Secured with 256-bit SSL encryption
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Scripts -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function showNewAddressForm() {
            document.getElementById('new-address-form').style.display = 'block';
        }

        function cancelNewAddress() {
            document.getElementById('new-address-form').style.display = 'none';
            document.getElementById('address-form').reset();
        }

        function validateAndSaveAddress() {
    const fullName = document.getElementById('fullName').value.trim();
    const address1 = document.getElementById('address1').value.trim();
    const city     = document.getElementById('city').value.trim();
    const state    = document.getElementById('state').value.trim();
    const pincode  = document.getElementById('pincode').value.trim();
    const phone    = document.getElementById('phone').value.trim();
    const email    = document.getElementById('email').value.trim();

    const namePattern = /^[a-zA-Z\s.]+$/;
    const placePattern = /^[a-zA-Z\s]+$/;

    if (!fullName || !address1 || !city || !state || !pincode || !phone || !email) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'All required fields must be filled out.' });
        return;
    }
    if (!namePattern.test(fullName)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Full Name must only contain letters, spaces, or dots.' });
        return;
    }
    if (!placePattern.test(city)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'City must only contain letters and spaces.' });
        return;
    }
    if (!placePattern.test(state)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'State must only contain letters and spaces.' });
        return;
    }
    if (!/^\d{6}$/.test(pincode)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Please enter a valid 6-digit pincode.' });
        return;
    }
    if (!/^\d{10}$/.test(phone)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Please enter a valid 10-digit phone number.' });
        return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Please enter a valid email address.' });
        return;
    }

    Swal.fire({ icon: 'success', title: 'Success', text: 'Address saved successfully!' })
        .then(() => { document.getElementById('address-form').submit(); });
}

        async function placeOrder() {
            const selectedAddress = document.querySelector('input[name="address"]:checked');
            if (!selectedAddress) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Please select a delivery address.' });
                return;
            }

            const selectedPayment = document.querySelector('input[name="payment-method"]:checked');
            if (!selectedPayment) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Please select a payment method.' });
                return;
            }

            const addressId     = selectedAddress.value;
            const paymentMethod = selectedPayment.value;
            const totalPriceText = document.getElementById('total-payable').textContent;
            const totalPrice     = parseInt(totalPriceText.replace('₹', '').trim());

            if (paymentMethod === 'COD' || paymentMethod === 'Wallet') {
                placeOrderCODorWallet(addressId, totalPrice, paymentMethod);
            } else {
                try {
                    const orderId = await createRazorpayOrder(totalPrice);
                    if (orderId) handleRazorpayPayment(orderId, addressId, totalPrice);
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({ title: 'Order not placed', text: 'An unexpected error occurred. Please try again.', icon: 'error' })
                        .then(() => { window.location.href = '/cart'; });
                }
            }
        }

        function placeOrderCODorWallet(addressId, totalPrice, paymentMethod) {
            fetch('/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ addressId, paymentMethod, totalPrice })
            })
            .then(r => r.json())
            .then(data => {
                if (data.message === 'Success') {
                    Swal.fire({ title: 'Order Successful', text: 'Your order has been placed!', icon: 'success' })
                        .then(() => { window.location.href = '/'; });
                } else {
                    Swal.fire({ title: 'Order not placed', text: data.message, icon: 'error' })
                        .then(() => { window.location.href = '/cart'; });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({ title: 'Order not placed', text: 'An unexpected error occurred.', icon: 'error' })
                    .then(() => { window.location.href = '/cart'; });
            });
        }

        async function createRazorpayOrder(totalPrice) {
            const response = await $.ajax({
                url: '/payment/razorpay',
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                data: JSON.stringify({ amount: totalPrice * 100 })
            });
            return response.orderId;
        }

        function handleRazorpayPayment(orderId, addressId, totalPrice) {
            const options = {
                key: 'rzp_test_7DylGE19pXY4Lf',
                amount: totalPrice * 100,
                currency: 'INR',
                name: 'SANDGLASS',
                description: 'Purchase',
                image: '/user/assets/imgs/theme/sandglass-high-resolution-logo-transparent.svg',
                order_id: orderId,
                handler: function(response) {
                    verifyRazorpayPayment(response, addressId, totalPrice);
                },
                theme: { color: '#3C3489' }
            };
            const rzp = new Razorpay(options);
            rzp.on('payment.failed', function(response) {
                placeOrderCODorWallet(addressId, totalPrice, 'COD');
            });
            rzp.open();
        }

        function verifyRazorpayPayment(response, addressId, totalPrice) {
            $.ajax({
                url: '/verifypayment',
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                data: JSON.stringify({ response, addressId, paymentMethod: 'Razorpay', totalPrice })
            })
            .done(() => {
                Swal.fire({ title: 'Success', text: 'Payment successful', icon: 'success' })
                    .then(() => { window.location.href = '/'; });
            })
            .fail(err => {
                console.error('Verification failed:', err);
                Swal.fire({ title: 'Verification Failed', text: 'Please try again.', icon: 'error' })
                    .then(() => { window.location.href = '/cart'; });
            });
        }
    </script>
    <script>
        document.getElementById('logoutBtn').addEventListener('click', async (e) => {
            e.preventDefault();

            await fetch('/logout', {
                method: 'POST'
            });

            window.location.href = '/login';
        });
    </script>
    <script>
    const userBtn = document.getElementById('userDropdownBtn');
    const dropdown = document.querySelector('.sg-dropdown');

    userBtn.addEventListener('click', (e) => {
        e.preventDefault();

        dropdown.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
        if (
            !e.target.closest('.sg-user-wrap')
        ) {
            dropdown.classList.remove('active');
        }
    });
</script>

    <script src="user/assets/js/auto_complete.js"></script>
    <script src="user/assets/js/vendor/modernizr-3.6.0.min.js"></script>
    <script src="user/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="user/assets/js/vendor/jquery-migrate-3.3.0.min.js"></script>
    <script src="user/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="user/assets/js/plugins/slick.js"></script>
    <script src="user/assets/js/plugins/wow.js"></script>
    <script src="user/assets/js/plugins/perfect-scrollbar.js"></script>
    <script src="user/assets/js/plugins/select2.min.js"></script>
    <script src="user/assets/js/plugins/scrollup.js"></script>
    <script src="./user/assets/js/main.js?v=3.4"></script>
    <script src="./user/assets/js/shop.js?v=3.4"></script>
</body>
</html>