<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — Wishlist</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
            --success: #16A34A;
            --success-bg: #DCFCE7;
            --danger: #E24B4A;
            --danger-bg: #FCEBEB;
        }

        html,
        body {
            font-family: 'DM Sans', sans-serif;
            color: var(--gray-900);
            -webkit-font-smoothing: antialiased;
            background: var(--gray-50);
        }

        /* ── Header ── */
        .header-area {
            display: none !important;
        }

        .sg-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sg-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--purple-800);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
            color: var(--gray-900);
            letter-spacing: -0.2px;
        }

        .sg-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 64px;
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .sg-user-btn {
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-search {
            position: relative;
            flex: 0 0 240px;
        }

        .sg-search input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: var(--gray-50);
            color: var(--gray-900);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .sg-search input:focus {
            border-color: var(--purple-400);
            box-shadow: 0 0 0 3px var(--purple-50);
            background: var(--white);
        }

        .sg-search input::placeholder {
            color: var(--gray-200);
        }

        .sg-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
        }

        .sg-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sg-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            border: 1px solid var(--gray-100);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            color: var(--gray-600);
            position: relative;
            transition: background 0.15s, border-color 0.15s;
        }

        .sg-icon-btn:hover {
            background: var(--gray-50);
            border-color: var(--gray-200);
            color: var(--gray-900);
        }

        .sg-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            width: 18px;
            height: 18px;
            background: var(--purple-800);
            color: #fff;
            border-radius: 50%;
            font-size: 10px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sg-user-wrap {
            position: relative;
        }

        .sg-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border: 1px solid var(--gray-100);
            border-radius: 8px;
            background: var(--white);
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-900);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .sg-user-btn:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .sg-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--purple-100);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: var(--purple-800);
        }

        .sg-dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 12px;
            padding: 6px;
            min-width: 180px;
            box-shadow: 0 8px 24px rgba(60, 52, 137, 0.10);
            display: none;
            z-index: 200;
        }

        .sg-dropdown.active {
            display: block;
        }

        .sg-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--gray-900);
            text-decoration: none;
            border-radius: 8px;
        }

        .sg-dropdown a:hover {
            background: var(--gray-50);
        }

        .sg-dropdown-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 4px 0;
        }

        .sg-navbar {
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            z-index: 1040;
            background: var(--purple-900);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 0 48px;
            height: 46px;
        }

        .sg-navbar a {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            transition: color 0.15s;
            letter-spacing: 0.01em;
        }

        .sg-navbar a:hover {
            color: #fff;
        }

        .sg-page-offset {
            padding-top: 110px;
        }



        .sg-breadcrumb {
            padding: 35px 0 0;
            font-size: 13px;
            color: var(--gray-400);
            margin-bottom: 20px;
        }

        .sg-breadcrumb a {
            color: var(--gray-400);
            text-decoration: none;
        }

        .sg-breadcrumb a:hover {
            color: var(--purple-800);
        }

        .sg-breadcrumb span {
            margin: 0 8px;
        }

        .sg-page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .sg-page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 32px;
            font-weight: 400;
            color: var(--gray-900);
            margin-bottom: 6px;
        }

        .sg-page-subtitle {
            font-size: 14px;
            color: var(--gray-400);
        }

        .sg-dropdown a.danger {
            color: var(--danger);
        }

        .sg-dropdown a.danger:hover {
            background: var(--danger-bg);
        }

        @media (max-width:768px) {
            .sg-header-inner {
                padding: 0 20px;
            }

            .sg-search {
                display: none;
            }

            .sg-navbar {
                display: none;
            }

            .sg-page-offset {
                padding-top: 70px;
            }

            .sg-page {
                padding: 20px 16px 40px;
            }

            .sg-page-heading {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }
        }

        /* ── Page wrapper ── */

        .sg-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px 64px;
}

        /* ── Page heading ── */
        .sg-page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .sg-page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--gray-900);
        }

        .sg-page-count {
            font-size: 14px;
            color: var(--gray-400);
        }

        .sg-continue-btn {
            font-size: 13px;
            font-weight: 500;
            color: var(--purple-600);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sg-continue-btn:hover {
            text-decoration: underline;
        }

        /* ── Wishlist table ── */
        .sg-table-wrap {
            background: var(--white);
            border: 1px solid var(--gray-100);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 16px rgba(60, 52, 137, 0.05);
            overflow-x: auto;
        }

        .sg-table {
            width: 100%;
            border-collapse: collapse;
        }

        .sg-table thead tr {
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }

        .sg-table thead th {
            padding: 14px 20px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--gray-400);
            text-align: left;
        }

        .sg-table thead th:last-child {
            text-align: center;
        }

        .sg-table tbody tr {
            border-bottom: 1px solid var(--gray-100);
            transition: background 0.12s;
        }

        .sg-table tbody tr:last-child {
            border-bottom: none;
        }

        .sg-table tbody tr:hover {
            background: var(--gray-50);
        }

        .sg-table td {
            padding: 18px 20px;
            vertical-align: middle;
        }

        /* product cell */
        .sg-product-cell {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .sg-product-img {
            width: 60px;
            height: 60px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--gray-100);
            background: var(--gray-50);
            flex-shrink: 0;
        }

        .sg-product-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            text-decoration: none;
        }

        .sg-product-name:hover {
            color: var(--purple-600);
        }

        /* price */
        .sg-price {
            font-size: 15px;
            font-weight: 500;
            color: var(--gray-900);
        }

        /* status badges */

        .sg-badge-out {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 500;
            color: var(--danger);
            background: var(--danger-bg);
            padding: 4px 10px;
            border-radius: 20px;
        }

        /* action buttons */
        .sg-btn-cart {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            background: var(--purple-800);
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            transition: background 0.15s;
            text-decoration: none;
        }

        .sg-btn-cart:hover {
            background: var(--purple-900);
        }

        .sg-btn-contact {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            background: var(--white);
            color: var(--gray-600);
            border: 1px solid var(--gray-200);
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
        }

        .sg-remove-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border: none;
            background: transparent;
            cursor: pointer;
            color: var(--gray-400);
            border-radius: 6px;
            transition: color 0.15s, background 0.15s;
            margin: 0 auto;
        }

        .sg-remove-btn:hover {
            color: var(--danger);
            background: var(--danger-bg);
        }

        /* ── Empty state ── */
        .sg-empty {
            text-align: center;
            padding: 80px 20px;
        }

        .sg-empty-icon {
            width: 64px;
            height: 64px;
            background: var(--purple-50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .sg-empty h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 22px;
            font-weight: 400;
            color: var(--gray-900);
            margin-bottom: 8px;
        }

        .sg-empty p {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 24px;
        }

        .sg-empty-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 22px;
            background: var(--purple-800);
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.15s;
        }

        .sg-empty-btn:hover {
            background: var(--purple-900);
        }

        .sg-page-footer {
            text-align: center;
            padding: 24px;
            font-size: 12px;
            color: var(--gray-400);
            margin-top: 16px;
        }

        @media(max-width:768px) {


            .sg-header {
                padding: 14px 20px;
            }

            .sg-header-nav {
                display: none;
            }

            .sg-table thead th:nth-child(3),
            .sg-table td:nth-child(3) {
                display: none;
            }
        }
    </style>
</head>

<body>
    <header class="sg-header">
        <div class="sg-header-inner">
            <a href="/" class="sg-logo">
                <div class="sg-logo-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4" />
                    </svg>
                </div>
                <span class="sg-logo-text">Sandglass</span>
            </a>

            <div class="sg-search">
                <span class="sg-search-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.35-4.35" />
                    </svg>
                </span>
                <form action="/shop" method="get">
                    <input name="search" type="text" placeholder="Search for items…">
                </form>
            </div>

            <div class="sg-header-actions">
                <a href="/wishlist" class="sg-icon-btn" title="Wishlist">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path
                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                </a>

                <a href="/cart" class="sg-icon-btn" title="Cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 01-8 0" />
                    </svg>
                </a>

                <% if(userData) { %>
                    <div class="sg-user-wrap">
                        <a href="#" id="userDropdownBtn" class="sg-user-btn">
                            <div class="sg-user-avatar">
                                <%= userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <%= userData.username %>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                        </a>

                        <div class="sg-dropdown">
                            <a href="/profile">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                                Profile
                            </a>

                            <div class="sg-dropdown-divider"></div>

                            <a href="/logout" class="danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                                Logout
                            </a>
                        </div>
                    </div>
                    <% } else { %>
                        <a href="/login" class="sg-user-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            Log in
                        </a>
                        <% } %>
            </div>
        </div>
    </header>

    <nav class="sg-navbar">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
    </nav>

    <div class="sg-page-offset"></div>

        <div class="sg-wrap">
            <div class="sg-breadcrumb">
                <a href="/">Home</a>
                <span>›</span>
                <a href="/shop">Shop</a>
                <span>›</span>
                <span>Wishlist</span>
            </div>

            <div class="sg-page-heading">
                <div>
                    <h1 class="sg-page-title">My Wishlist</h1>
                    <p class="sg-page-subtitle">
                        Save your favorite products and revisit them anytime.
                    </p>
                </div>

                <a href="/shop" class="sg-continue-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12" />
                        <polyline points="12 19 5 12 12 5" />
                    </svg>
                    Continue shopping
                </a>
            </div>

            <% if(wishlistData?.products[0]) { %>
                <div class="sg-table-wrap">
                    <table class="sg-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Action</th>
                                <th>Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% wishlistData.products.forEach(data=> { %>
                                <tr>
                                    <td>
                                        <div class="sg-product-cell">
                                            <img class="sg-product-img"
                                                src="/uploads/<%= data.productId.productImage[0] %>"
                                                alt="<%= data.productId.productName %>">
                                            <a class="sg-product-name"
                                                href="/product_details?id=<%= data.productId._id %>">
                                                <%= data.productId.productName %>
                                            </a>
                                        </div>
                                    </td>
                                    <td><span class="sg-price">₹<%= data.finalPrice %></span></td>
                                    <td>
                                        <% if(data.productId.stock) { %>
                                            <span class="sg-badge-in">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12" />
                                                </svg>
                                                In Stock
                                            </span>
                                            <% } else { %>
                                                <span class="sg-badge-out">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18" />
                                                        <line x1="6" y1="6" x2="18" y2="18" />
                                                    </svg>
                                                    Out of Stock
                                                </span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <% if(data.productId.stock) { %>
                                            <button class="sg-btn-cart"
                                                onclick="addToCart('<%= data.productId._id %>')">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <circle cx="9" cy="21" r="1" />
                                                    <circle cx="20" cy="21" r="1" />
                                                    <path
                                                        d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" />
                                                </svg>
                                                Add to cart
                                            </button>
                                            <% } else { %>
                                                <button class="sg-btn-contact">Contact Us</button>
                                                <% } %>
                                    </td>
                                    <td>
                                        <button class="sg-remove-btn"
                                            onclick="removeFromWishlist('<%= data.productId._id %>')" title="Remove">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                                                <path d="M10 11v6M14 11v6" />
                                                <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <% } else { %>
                    <div class="sg-table-wrap">
                        <div class="sg-empty">
                            <div class="sg-empty-icon">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#534AB7"
                                    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path
                                        d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                                </svg>
                            </div>
                            <h3>Your wishlist is empty</h3>
                            <p>Save items you love and come back to them anytime.</p>
                            <a href="/shop" class="sg-empty-btn">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1" />
                                    <circle cx="20" cy="21" r="1" />
                                    <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" />
                                </svg>
                                Browse products
                            </a>
                        </div>
                    </div>
                    <% } %>
        </div>
        <p class="sg-page-footer">© 2026 Sandglass. All rights reserved.</p>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function addToCart(productId) {
            let response = await fetch('product/add_to_cart', {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
            });
            if (!response.ok) {
                console.log(`error --- ${response.statusText}`);
            } else {
                window.location.href = "/cart";
            }
        }

        async function removeFromWishlist(productId) {
            const result = await Swal.fire({
                title: 'Remove from wishlist?',
                text: 'This item will be removed from your wishlist.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3C3489',
                cancelButtonColor: '#888780',
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Keep it'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch('/removefromwishlist', {
                        method: "DELETE",
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId })
                    });
                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Removed!',
                            text: 'The product has been removed from your wishlist.',
                            confirmButtonColor: '#3C3489'
                        }).then(result => {
                            if (result.isConfirmed) location.reload();
                        });
                    } else {
                        throw new Error('Failed to remove from wishlist');
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Oops...', text: 'Something went wrong!' });
                }
            }
        }
    </script>

    <script>
        const userBtn = document.getElementById('userDropdownBtn');
        const dropdown = document.querySelector('.sg-dropdown');

        if (userBtn) {
            userBtn.addEventListener('click', (e) => {
                e.preventDefault();
                dropdown.classList.toggle('active');
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.sg-user-wrap')) {
                    dropdown.classList.remove('active');
                }
            });
        }
    </script>
</body>

</html>