<!DOCTYPE html>
<html class="no-js" lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass — About</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="user/assets/imgs/theme/favicon.svg">
    <link rel="stylesheet" href="user/assets/css/main.css?v=3.4">
    <link rel="stylesheet" href="user/assets/css/auto_complete.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --purple-50: #EEEDFE;
            --purple-100: #CECBF6;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --purple-900: #26215C;
            --gray-50: #F7F6F3;
            --gray-100: #EEECE8;
            --gray-200: #D3D1C7;
            --gray-400: #888780;
            --gray-600: #5F5E5A;
            --gray-900: #1A1918;
            --white: #FFFFFF;
        }

        .header-area { display: none !important; }

        /* ── Header (identical to home) ── */
        .sg-header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1050;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gray-100);
            font-family: 'DM Sans', sans-serif;
        }

        .sg-header-inner {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 48px; height: 64px;
        }

        .sg-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
        .sg-logo-icon { width: 32px; height: 32px; background: var(--purple-800); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .sg-logo-text { font-family: 'DM Serif Display', serif; font-size: 20px; color: var(--gray-900); letter-spacing: -0.2px; }

        .sg-nav { display: flex; align-items: center; gap: 32px; list-style: none; margin: 0; padding: 0; }
        .sg-nav a { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; color: var(--gray-600); text-decoration: none; transition: color 0.15s; }
        .sg-nav a:hover, .sg-nav a.active { color: var(--purple-800); }

        .sg-search { position: relative; flex: 0 0 240px; }
        .sg-search input { width: 100%; padding: 8px 12px 8px 36px; font-size: 13px; font-family: 'DM Sans', sans-serif; border: 1px solid var(--gray-200); border-radius: 8px; background: var(--gray-50); color: var(--gray-900); outline: none; transition: border-color 0.15s, box-shadow 0.15s; }
        .sg-search input:focus { border-color: var(--purple-400); box-shadow: 0 0 0 3px var(--purple-50); background: var(--white); }
        .sg-search input::placeholder { color: var(--gray-200); }
        .sg-search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--gray-400); pointer-events: none; }

        .sg-header-actions { display: flex; align-items: center; gap: 8px; }
        .sg-icon-btn { width: 38px; height: 38px; border-radius: 8px; border: 1px solid var(--gray-100); background: var(--white); display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; color: var(--gray-600); transition: background 0.15s, border-color 0.15s; }
        .sg-icon-btn:hover { background: var(--gray-50); border-color: var(--gray-200); color: var(--gray-900); }

        .sg-user-wrap { position: relative; }
        .sg-user-btn { display: flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--gray-100); border-radius: 8px; background: var(--white); font-size: 13px; font-weight: 500; font-family: 'DM Sans', sans-serif; color: var(--gray-900); cursor: pointer; text-decoration: none; transition: background 0.15s; }
        .sg-user-btn:hover { background: var(--gray-50); color: var(--gray-900); }
        .sg-user-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--purple-100); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--purple-800); }

        .sg-dropdown { position: absolute; right: 0; top: calc(100% + 8px); background: var(--white); border: 1px solid var(--gray-100); border-radius: 12px; padding: 6px; min-width: 180px; box-shadow: 0 8px 24px rgba(60,52,137,0.10); display: none; z-index: 200; }
        .sg-dropdown.active { display: block; }
        .sg-dropdown a { display: flex; align-items: center; gap: 8px; padding: 9px 12px; font-size: 13px; color: var(--gray-900); text-decoration: none; border-radius: 8px; transition: background 0.12s; }
        .sg-dropdown a:hover { background: var(--gray-50); }
        .sg-dropdown a.danger { color: #E24B4A; }
        .sg-dropdown a.danger:hover { background: #FCEBEB; }
        .sg-dropdown-divider { height: 1px; background: var(--gray-100); margin: 4px 0; }

        .sg-navbar { position: fixed; top: 64px; left: 0; right: 0; z-index: 1040; background: var(--purple-900); display: flex; align-items: center; justify-content: center; gap: 40px; padding: 0 48px; height: 46px; font-family: 'DM Sans', sans-serif; }
        .sg-navbar a { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.75); text-decoration: none; transition: color 0.15s; letter-spacing: 0.01em; }
        .sg-navbar a:hover, .sg-navbar a.active { color: #fff; }

        .sg-page-offset { padding-top: 110px; }

        /* ── About-specific styles ── */
        body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--gray-900); margin: 0; }

        /* Hero */
        .about-hero {
            background:
                radial-gradient(ellipse 55% 60% at 95% 10%, var(--purple-50) 0%, transparent 60%),
                radial-gradient(ellipse 35% 40% at 0% 100%, var(--purple-100) 0%, transparent 55%),
                var(--gray-50);
            padding: 72px 0 64px;
        }

        .about-hero-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 48px;
            display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
        }

        .about-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--purple-600);
            background: var(--purple-50); border: 1px solid var(--purple-100);
            padding: 5px 12px; border-radius: 20px; margin-bottom: 20px;
        }

        .about-hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 48px; font-weight: 400; line-height: 1.15;
            color: var(--gray-900); margin: 0 0 20px;
        }

        .about-hero h1 em { font-style: italic; color: var(--purple-800); }

        .about-hero p {
            font-size: 16px; color: var(--gray-600); line-height: 1.75;
            margin: 0 0 16px;
        }

        .about-hero-actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

        .btn-primary-sg {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            background: var(--purple-800); color: #fff;
            text-decoration: none; border: none; cursor: pointer;
            transition: background 0.15s;
        }
        .btn-primary-sg:hover { background: var(--purple-900); color: #fff; }

        .btn-outline-sg {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            background: transparent; color: var(--gray-900);
            border: 1px solid var(--gray-200); text-decoration: none;
            transition: border-color 0.15s, background 0.15s;
        }
        .btn-outline-sg:hover { background: var(--gray-50); border-color: var(--gray-400); color: var(--gray-900); }

        /* Hero image */
        .about-hero-img {
            border-radius: 20px; overflow: hidden;
            border: 1px solid var(--gray-100);
            box-shadow: 0 24px 64px rgba(60,52,137,0.12);
            aspect-ratio: 4/3;
        }
        .about-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

        /* Stats strip */
        .stats-strip {
            background: var(--purple-900);
            padding: 40px 0;
        }

        .stats-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 48px;
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 0;
        }

        .stat-item {
            text-align: center;
            padding: 0 24px;
            border-right: 1px solid rgba(255,255,255,0.1);
        }
        .stat-item:last-child { border-right: none; }

        .stat-number {
            font-family: 'DM Serif Display', serif;
            font-size: 36px; font-weight: 400; color: #fff;
            line-height: 1;
        }

        .stat-label {
            font-size: 13px; color: rgba(255,255,255,0.6);
            margin-top: 6px; font-weight: 400;
        }

        /* Mission section */
        .about-section {
            padding: 80px 0;
        }

        .about-section-alt { background: var(--gray-50); }

        .about-section-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 48px;
        }

        .section-eyebrow {
            font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--purple-600);
            margin-bottom: 12px; display: block;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: 36px; font-weight: 400; color: var(--gray-900);
            margin: 0 0 16px; line-height: 1.2;
        }

        .section-lead {
            font-size: 16px; color: var(--gray-600); line-height: 1.75;
            max-width: 580px; margin: 0 0 48px;
        }

        /* Two-col layout */
        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
        .two-col.reverse { direction: rtl; }
        .two-col.reverse > * { direction: ltr; }

        .col-img {
            border-radius: 16px; overflow: hidden;
            border: 1px solid var(--gray-100);
            box-shadow: 0 12px 40px rgba(60,52,137,0.08);
            aspect-ratio: 4/3;
        }
        .col-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .col-text p { font-size: 15px; color: var(--gray-600); line-height: 1.75; margin: 0 0 16px; }

        /* Value cards */
        .values-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
            margin-top: 48px;
        }

        .value-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; padding: 28px 24px;
            transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
        }
        .value-card:hover {
            box-shadow: 0 8px 28px rgba(60,52,137,0.10);
            transform: translateY(-3px);
            border-color: var(--purple-200);
        }

        .value-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: var(--purple-50); border: 1px solid var(--purple-100);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 16px;
        }

        .value-icon svg { color: var(--purple-800); }

        .value-title {
            font-size: 15px; font-weight: 500; color: var(--gray-900);
            margin: 0 0 8px;
        }

        .value-desc {
            font-size: 13.5px; color: var(--gray-600); line-height: 1.65; margin: 0;
        }

        /* Team */
        .team-grid {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
        }

        .team-card {
            background: var(--white); border: 1px solid var(--gray-100);
            border-radius: 16px; overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
            text-align: center;
        }
        .team-card:hover { box-shadow: 0 8px 28px rgba(60,52,137,0.10); transform: translateY(-3px); }

        .team-img {
            aspect-ratio: 1; overflow: hidden; background: var(--gray-50);
        }
        .team-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
        .team-card:hover .team-img img { transform: scale(1.05); }

        .team-info { padding: 16px; }
        .team-name { font-size: 14px; font-weight: 500; color: var(--gray-900); margin: 0 0 4px; }
        .team-role { font-size: 12.5px; color: var(--purple-600); font-weight: 500; }

        /* CTA */
        .about-cta {
            background: var(--purple-900);
            padding: 72px 0;
            text-align: center;
        }

        .about-cta-inner { max-width: 600px; margin: 0 auto; padding: 0 48px; }

        .about-cta h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 36px; font-weight: 400; color: #fff;
            margin: 0 0 16px; line-height: 1.2;
        }

        .about-cta p { font-size: 16px; color: rgba(255,255,255,0.7); margin: 0 0 32px; line-height: 1.65; }

        .btn-white {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 28px; border-radius: 10px;
            font-size: 14px; font-weight: 500; font-family: 'DM Sans', sans-serif;
            background: #fff; color: var(--purple-900);
            text-decoration: none; border: none; cursor: pointer;
            transition: background 0.15s, color 0.15s;
        }
        .btn-white:hover { background: var(--purple-50); color: var(--purple-900); }

        /* Footer */
        footer.main { font-family: 'DM Sans', sans-serif; }

        /* Responsive */
        @media (max-width: 1024px) {
            .team-grid { grid-template-columns: repeat(2, 1fr); }
            .values-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .sg-header-inner { padding: 0 20px; }
            .sg-search, .sg-nav { display: none; }
            .sg-navbar { display: none; }
            .sg-page-offset { padding-top: 64px; }
            .about-hero-inner, .two-col { grid-template-columns: 1fr; gap: 32px; }
            .two-col.reverse { direction: ltr; }
            .about-hero h1 { font-size: 34px; }
            .stats-inner { grid-template-columns: repeat(2, 1fr); gap: 24px; }
            .stat-item { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 24px; }
            .stat-item:nth-child(2n) { border-bottom: none; }
            .values-grid { grid-template-columns: 1fr; }
            .team-grid { grid-template-columns: repeat(2, 1fr); }
            .about-section-inner { padding: 0 20px; }
            .about-hero-inner { padding: 0 20px; }
            .stats-inner { padding: 0 20px; }
        }
    </style>
</head>

<body>

    <!-- ── Header ── -->
    <header class="sg-header">
        <div class="sg-header-inner">
            <a href="/" class="sg-logo">
                <div class="sg-logo-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/>
                    </svg>
                </div>
                <span class="sg-logo-text">Sandglass</span>
            </a>

            <div class="sg-search">
                <span class="sg-search-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                </span>
                <form action="/shop" method="get">
                    <input name="search" type="text" placeholder="Search for items…">
                </form>
            </div>

            <div class="sg-header-actions">
                <% if(userData) { %>
                    <a href="/wishlist" class="sg-icon-btn" title="Wishlist">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </a>
                    <a href="/cart" class="sg-icon-btn" title="Cart">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 01-8 0"/>
                        </svg>
                    </a>
                    <div class="sg-user-wrap">
                        <a id="userDropdownBtn" class="sg-user-btn">
                            <div class="sg-user-avatar"><%= userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %></div>
                            <%= userData.username %>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </a>
                        <div class="sg-dropdown">
                            <a href="/profile">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profile
                            </a>
                            <div class="sg-dropdown-divider"></div>
                            <a href="/logout" class="danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="sg-user-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Log in
                    </a>
                    <a href="/signup" style="padding:7px 14px;background:var(--purple-800);color:#fff;border-radius:8px;font-size:13px;font-weight:500;font-family:'DM Sans',sans-serif;text-decoration:none;transition:background 0.15s;" onmouseover="this.style.background='var(--purple-900)'" onmouseout="this.style.background='var(--purple-800)'">Sign up</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- ── Navbar ── -->
    <nav class="sg-navbar">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/about" class="active">About</a>
        <a href="/contact">Contact</a>
    </nav>

    <div class="sg-page-offset"></div>

    <!-- ── Hero ── -->
    <section class="about-hero">
        <div class="about-hero-inner">
            <div>
                <div class="about-eyebrow">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14M5 21h14M8 3v4a4 4 0 008 0V3M8 21v-4a4 4 0 018 0v4"/></svg>
                    Our Company
                </div>
                <h1>Timeless Elegance,<br><em>Modern Convenience</em></h1>
                <p>At Sandglass, we're dedicated to helping you find the perfect watch that fits your style and needs. We offer a wide range of timepieces, from elegant analog watches to modern smartwatches.</p>
                <p>Our mission is to make the process of finding and purchasing a watch as easy and enjoyable as possible — quality, variety, and exceptional customer service, every time.</p>
                <div class="about-hero-actions">
                    <a href="/shop" class="btn-primary-sg">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                        Shop Now
                    </a>
                    <a href="/contact" class="btn-outline-sg">Get in Touch</a>
                </div>
            </div>
            <div class="about-hero-img">
                <img src="user/assets/imgs/page/about-1.png" alt="About Sandglass">
            </div>
        </div>
    </section>

    <!-- ── Stats strip ── -->
    <div class="stats-strip">
        <div class="stats-inner">
            <div class="stat-item">
                <div class="stat-number">12K+</div>
                <div class="stat-label">Happy Customers</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">500+</div>
                <div class="stat-label">Timepieces Available</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">8+</div>
                <div class="stat-label">Years in Business</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">4.9★</div>
                <div class="stat-label">Average Rating</div>
            </div>
        </div>
    </div>

    <!-- ── Our Story ── -->
    <section class="about-section">
        <div class="about-section-inner">
            <div class="two-col">
                <div class="col-img">
                    <img src="user/assets/imgs/page/about-1.png" alt="Our Story">
                </div>
                <div class="col-text">
                    <span class="section-eyebrow">Our Story</span>
                    <h2 class="section-heading">Where every second counts</h2>
                    <p>Founded with a passion for horology, Sandglass began as a small boutique in Kochi with a single goal: to bring exceptional timepieces to people who appreciate the craft of watchmaking.</p>
                    <p>Over the years, we've grown into a trusted destination for watch enthusiasts across India — but our values have stayed the same. Every watch we carry is hand-selected for quality, durability, and design.</p>
                    <p>From classic dress watches to rugged sports models, we believe the right watch tells more than just the time — it tells your story.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Our Values ── -->
    <section class="about-section about-section-alt">
        <div class="about-section-inner">
            <span class="section-eyebrow">What We Stand For</span>
            <h2 class="section-heading">Our Values</h2>
