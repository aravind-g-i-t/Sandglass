<!DOCTYPE HTML>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Sandglass – Coupons</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link rel="shortcut icon" type="image/x-icon" href="/admin/assets/imgs/theme/favicon.svg">
  <link href="/admin/assets/css/main.css" rel="stylesheet" type="text/css" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --purple-50: #EEEDFE;
      --purple-200: #AFA9EC;
      --purple-400: #7F77DD;
      --purple-600: #534AB7;
      --purple-800: #3C3489;
      --green-50: #EAF3DE;
      --green-800: #27500A;
      --amber-50: #FAEEDA;
      --amber-600: #854F0B;
      --red-50: #FCEBEB;
      --red-600: #A32D2D;
      --bg-primary: #ffffff;
      --bg-secondary: #f8f7fc;
      --bg-tertiary: #f2f0f9;
      --text-primary: #1a1825;
      --text-secondary: #6b6880;
      --text-tertiary: #9b98ab;
      --border: rgba(83, 74, 183, 0.12);
      --border-md: rgba(83, 74, 183, 0.2);
      --radius-md: 8px;
      --radius-lg: 12px;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: var(--bg-tertiary);
      color: var(--text-primary);
      font-size: 14px;
      line-height: 1.6;
    }

    .shell {
      display: grid;
      grid-template-columns: 230px 1fr;
      min-height: 100vh;
    }

    /* ── Sidebar ── */
    .sidebar {
      background: var(--bg-primary);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .brand {
      padding: 1.25rem 1.25rem 1rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 34px;
      height: 34px;
      background: var(--purple-600);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-tertiary);
    }

    nav {
      padding: 1rem 0.75rem;
      flex: 1;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 10px;
      letter-spacing: .08em;
      color: var(--text-tertiary);
      padding: 0 0.5rem;
      margin: 1rem 0 0.35rem;
      text-transform: uppercase;
      font-weight: 500;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 8px 10px;
      border-radius: var(--radius-md);
      font-size: 13.5px;
      color: var(--text-secondary);
      margin-bottom: 1px;
      transition: background .15s, color .15s;
      text-decoration: none;
    }

    .nav-item:hover {
      background: var(--bg-secondary);
      color: var(--text-primary);
    }

    .nav-item.active {
      background: var(--purple-50);
      color: var(--purple-600);
      font-weight: 500;
    }

    .nav-item i {
      font-size: 17px;
    }

    .nav-item.active i {
      color: var(--purple-600);
    }

    .sidebar-footer {
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border);
    }

    .user-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--purple-50);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--purple-600);
      flex-shrink: 0;
    }

    .user-name {
      font-size: 13px;
      font-weight: 500;
    }

    .user-role {
      font-size: 11px;
      color: var(--text-tertiary);
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-secondary);
      padding: 7px 10px;
      border-radius: var(--radius-md);
      transition: background .15s;
      text-decoration: none;
    }

    .logout-btn:hover {
      background: var(--bg-secondary);
    }

    /* ── Main ── */
    .main {
      display: flex;
      flex-direction: column;
    }

    .topbar {
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .search {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 6px 12px;
      width: 260px;
    }

    .search input {
      background: none;
      border: none;
      outline: none;
      font-size: 13px;
      color: var(--text-primary);
      width: 100%;
    }

    .search input::placeholder {
      color: var(--text-tertiary);
    }

    .search i {
      font-size: 16px;
      color: var(--text-tertiary);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--bg-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background .15s;
      text-decoration: none;
    }

    .icon-btn:hover {
      background: var(--bg-secondary);
    }

    .icon-btn i {
      font-size: 17px;
      color: var(--text-secondary);
    }

    /* ── Content ── */
    .content {
      padding: 1.5rem;
      flex: 1;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      gap: 12px;
      flex-wrap: wrap;
    }

    .page-title {
      font-size: 20px;
      font-weight: 600;
    }

    .page-sub {
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 2px;
    }

    .add-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 500;
      background: var(--purple-600);
      color: #fff;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background .15s;
    }

    .add-btn:hover {
      background: var(--purple-800);
    }

    .add-btn i {
      font-size: 16px;
    }

    /* ── Coupons card ── */
    .coupons-card {
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .card-top {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
    }

    .search-coupon {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 6px 12px;
      width: 280px;
    }

    .search-coupon input {
      background: none;
      border: none;
      outline: none;
      font-size: 13px;
      color: var(--text-primary);
      width: 100%;
    }

    .search-coupon input::placeholder {
      color: var(--text-tertiary);
    }

    .search-coupon i {
      font-size: 16px;
      color: var(--text-tertiary);
    }

    .search-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      display: flex;
    }

    /* Table */
    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th {
      text-align: left;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-tertiary);
      padding: 10px 16px;
      text-transform: uppercase;
      letter-spacing: .05em;
      background: var(--bg-secondary);
      white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      color: var(--text-primary);
      vertical-align: middle;
      white-space: nowrap;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover td {
      background: var(--bg-secondary);
    }

    .coupon-code {
      font-family: 'Courier New', monospace;
      color: var(--purple-600);
      font-weight: 600;
      font-size: 13px;
      background: var(--purple-50);
      padding: 2px 8px;
      border-radius: 5px;
      display: inline-block;
    }

    .desc-cell {
      color: var(--text-secondary);
      font-size: 12.5px;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .date-cell {
      color: var(--text-secondary);
      font-size: 12.5px;
    }

    .amount {
      font-weight: 500;
    }

    /* Status badge */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 500;
    }

    .badge-active {
      background: var(--green-50);
      color: var(--green-800);
    }

    .badge-inactive {
      background: var(--red-50);
      color: var(--red-600);
    }

    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }

    /* Action buttons */
    .action-group {
      display: flex;
      align-items: center;
      gap: 6px;
      justify-content: flex-end;
    }

    .edit-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: var(--radius-md);
      font-size: 12px;
      font-weight: 500;
      border: 1px solid var(--border-md);
      background: var(--bg-secondary);
      color: var(--text-secondary);
      text-decoration: none;
      transition: all .15s;
    }

    .edit-btn:hover {
      background: var(--purple-50);
      color: var(--purple-600);
      border-color: var(--purple-200);
    }

    .edit-btn i {
      font-size: 13px;
    }

    .toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: var(--radius-md);
      font-size: 12px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      transition: all .15s;
    }

    .toggle-btn i {
      font-size: 13px;
    }

    .toggle-btn.is-active {
      background: var(--red-50);
      color: var(--red-600);
      border: 1px solid rgba(163, 45, 45, 0.18);
    }

    .toggle-btn.is-active:hover {
      background: #f5d5d5;
    }

    .toggle-btn.is-inactive {
      background: var(--green-50);
      color: var(--green-800);
      border: 1px solid rgba(39, 80, 10, 0.18);
    }

    .toggle-btn.is-inactive:hover {
      background: #d5eabf;
    }

    /* Pagination */
    .pager {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border);
    }

    .page-btn {
      width: 30px;
      height: 30px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      border: 1px solid var(--border);
      background: var(--bg-primary);
      color: var(--text-secondary);
      cursor: pointer;
      text-decoration: none;
      transition: all .15s;
    }

    .page-btn:hover {
      background: var(--bg-secondary);
    }

    .page-btn.active {
      background: var(--purple-50);
      color: var(--purple-600);
      border-color: var(--purple-200);
      font-weight: 600;
    }

    /* Empty state */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      gap: 12px;
      color: var(--text-tertiary);
    }

    .empty-state i {
      font-size: 48px;
      color: var(--purple-200);
    }

    .empty-state h3 {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .empty-state p {
      font-size: 13px;
    }

    footer {
      padding: 1rem 1.5rem;
      font-size: 12px;
      color: var(--text-tertiary);
      border-top: 1px solid var(--border);
      background: var(--bg-primary);
    }
  </style>
</head>

<body>

  <div class="shell">

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">
          <img src="/admin/assets/imgs/theme/sandglass-high-resolution-logo-transparent.svg"
            style="width:22px;height:22px;object-fit:contain;filter:brightness(0) invert(1)" alt="Sandglass">
        </div>
        <div>
          <div class="brand-name">Sandglass</div>
          <div class="brand-sub">Admin panel</div>
        </div>
      </div>

      <nav>
        <div class="nav-label">Main</div>
        <a href="/admin/dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
        <a href="/admin/products" class="nav-item"><i class="ti ti-shopping-bag"></i> Products</a>
        <a href="/admin/orders" class="nav-item"><i class="ti ti-shopping-cart"></i> Orders</a>
        <a href="/admin/users" class="nav-item"><i class="ti ti-users"></i> Users</a>

        <div class="nav-label">Catalog</div>
        <a href="/admin/add_product" class="nav-item"><i class="ti ti-circle-plus"></i> Add product</a>
        <a href="/admin/categories" class="nav-item"><i class="ti ti-apps"></i> Categories</a>
        <a href="/admin/coupons" class="nav-item active"><i class="ti ti-ticket"></i> Coupons</a>

        <div class="nav-label">Analytics</div>
        <a href="/admin/offers" class="nav-item"><i class="ti ti-tag"></i> Offers</a>

      </nav>

      <div class="sidebar-footer">
        <div class="user-row">
          <div class="avatar">AD</div>
          <div>
            <div class="user-name">Admin</div>
            <div class="user-role">Store manager</div>
          </div>
        </div>
        <a href="#" id="logoutBtn" class="logout-btn"><i class="ti ti-logout"></i> Sign out</a>
      </div>
    </aside>

    <!-- ── Main ── -->
    <div class="main">

      <header class="topbar">
        <div class="search">
          <i class="ti ti-search"></i>
          <input type="text" placeholder="Search products, orders…">
        </div>
        <div class="topbar-right">
          <a href="#" class="icon-btn darkmode" title="Dark mode"><i class="ti ti-moon"></i></a>
          <a href="#" class="icon-btn requestfullscreen" title="Fullscreen"><i class="ti ti-maximize"></i></a>
        </div>
      </header>

      <div class="content">

        <div class="page-header">
          <div>
            <div class="page-title">Coupon List</div>
            <div class="page-sub">Manage discount coupons and promotions</div>
          </div>
          <a href="/admin/add_coupon" class="add-btn">
            <i class="ti ti-plus"></i> Add New Coupon
          </a>
        </div>

        <div class="coupons-card">

          <!-- Search bar -->
          <div class="card-top">
            <form method="get" action="/admin/coupons">
              <div class="search-coupon">
                <i class="ti ti-search"></i>
                <input name="search" type="text" placeholder="Search by Coupon Code…">
                <button class="search-btn" type="submit">
                  <i class="ti ti-arrow-right" style="font-size:15px;color:var(--text-tertiary)"></i>
                </button>
              </div>
            </form>
          </div>

          <!-- Table -->
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Description</th>
                  <th>Discount</th>
                  <th>Min. Amount</th>
                  <th>Limit</th>
                  <th>Expires On</th>
                  <th>Status</th>
                  <th style="text-align:right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% coupons.forEach(coupon=> { %>
                  <tr>
                    <td><span class="coupon-code">
                        <%= coupon.code %>
                      </span></td>
                    <td class="desc-cell">
                      <%= coupon.description %>
                    </td>
                    <td class="amount">
                      <%= coupon.discountPercentage %>%
                    </td>
                    <td class="amount">₹<%= coupon.minPurchaseAmount %>
                    </td>
                    <td>
                      <%= coupon.quantityLimit %>
                    </td>
                    <td class="date-cell">
                      <%= new Date(coupon.expiryDate).toLocaleDateString() %>
                    </td>
                    <td>
                      <% if (coupon.isActive) { %>
                        <span class="badge badge-active">Active</span>
                        <% } else { %>
                          <span class="badge badge-inactive">Inactive</span>
                          <% } %>
                    </td>
                    <td>
                      <div class="action-group">
                        <a href="/admin/edit_coupon/<%= coupon._id %>" class="edit-btn">
                          <i class="ti ti-pencil"></i> Edit
                        </a>
                        <button
                          class="toggle-btn toggle-status-btn <%= coupon.isActive ? 'is-active' : 'is-inactive' %>"
                          data-id="<%= coupon._id %>" data-active="<%= coupon.isActive %>">
                          <% if (coupon.isActive) { %>
                            <i class="ti ti-ban"></i> Disable
                            <% } else { %>
                              <i class="ti ti-check"></i> Activate
                              <% } %>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <nav class="pager" aria-label="Page navigation">
            <% for (let i=1; i <=totalPages; i++) { %>
              <a class="page-btn <%= currentPage === i ? 'active' : '' %>" href="/admin/coupons?page=<%= i %>">
                <%= i %>
              </a>
              <% } %>
          </nav>

        </div>
      </div>

      <footer>
        <script>document.write(new Date().getFullYear())</script> &copy; Sandglass &mdash; All rights reserved
      </footer>

    </div>
  </div>

  <script src="/admin/assets/js/vendors/jquery-3.6.0.min.js"></script>
  <script src="/admin/assets/js/vendors/bootstrap.bundle.min.js"></script>
  <script src="/admin/assets/js/vendors/select2.min.js"></script>
  <script src="/admin/assets/js/vendors/perfect-scrollbar.js"></script>
  <script src="/admin/assets/js/vendors/jquery.fullscreen.min.js"></script>
  <script src="/admin/assets/js/main.js" type="text/javascript"></script>

  <div id="status-modal" style="
  display:none; position:fixed; inset:0; z-index:1000;
  background:rgba(0,0,0,.35);
  align-items:center; justify-content:center;
">
    <div style="
    background:var(--bg-primary); border-radius:var(--radius-lg);
    border:1px solid var(--border); padding:1.5rem;
    width:320px; box-shadow:0 8px 32px rgba(0,0,0,.12);
  ">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
        <div id="modal-icon-wrap" style="
        width:38px; height:38px; border-radius:50%;
        display:flex; align-items:center; justify-content:center; flex-shrink:0;
      ">
          <i id="modal-icon" style="font-size:19px;"></i>
        </div>
        <p id="modal-title" style="font-size:15px; font-weight:600; margin:0; color:var(--text-primary);"></p>
      </div>
      <p id="modal-body" style="font-size:13px; color:var(--text-secondary); margin:0 0 1.25rem 50px;"></p>
      <div style="display:flex; justify-content:flex-end;">
        <button id="modal-ok" style="
        padding:6px 18px; font-size:13px; font-weight:500;
        border-radius:var(--radius-md); cursor:pointer; border:none;
      ">OK</button>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('status-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');
    const modalIcon = document.getElementById('modal-icon');
    const modalWrap = document.getElementById('modal-icon-wrap');
    const modalOk = document.getElementById('modal-ok');

    function showModal(type, title, message) {
      const isSuccess = type === 'success';
      modalTitle.textContent = title;
      modalBody.textContent = message;
      modalIcon.className = isSuccess ? 'ti ti-check' : 'ti ti-x';
      modalIcon.style.color = isSuccess ? 'var(--green-800)' : 'var(--red-600)';
      modalWrap.style.background = isSuccess ? 'var(--green-50)' : 'var(--red-50)';
      modalOk.style.background = isSuccess ? 'var(--green-50)' : 'var(--red-50)';
      modalOk.style.color = isSuccess ? 'var(--green-800)' : 'var(--red-600)';
      modalOk.style.border = isSuccess
        ? '1px solid rgba(39,80,10,.2)' : '1px solid rgba(163,45,45,.2)';
      modal.style.display = 'flex';
    }

    modalOk.addEventListener('click', () => modal.style.display = 'none');
    modal.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });

    document.querySelectorAll('.toggle-status-btn').forEach(button => {
      button.addEventListener('click', function () {
        const couponId = this.dataset.id;
        const isActive = JSON.parse(this.dataset.active);

        fetch(`/admin/update_coupon_status/${couponId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isActive: !isActive })
        })
          .then(r => r.json())
          .then(data => {
            if (data.success) {
              const nowActive = !isActive;
              this.dataset.active = nowActive;
              this.className = `toggle-btn toggle-status-btn ${nowActive ? 'is-active' : 'is-inactive'}`;
              this.innerHTML = nowActive
                ? '<i class="ti ti-ban"></i> Disable'
                : '<i class="ti ti-check"></i> Activate';

              const badgeCell = this.closest('tr').querySelector('td:nth-child(7)');
              badgeCell.innerHTML = nowActive
                ? '<span class="badge badge-active">Active</span>'
                : '<span class="badge badge-inactive">Inactive</span>';

              showModal('success', 'Status updated',
                `Coupon has been ${nowActive ? 'activated' : 'disabled'} successfully.`);
            } else {
              showModal('error', 'Update failed', 'Failed to update coupon status. Please try again.');
            }
          })
          .catch(() => showModal('error', 'Update failed', 'A network error occurred. Please try again.'));
      });
    });
  </script>
  <script>
    document.getElementById('logoutBtn').addEventListener('click', async (e) => {
      e.preventDefault();

      await fetch('/admin/logout', {
        method: 'POST'
      });

      window.location.href = '/admin';
    });
  </script>


</body>

</html>