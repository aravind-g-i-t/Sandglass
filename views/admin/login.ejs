<!DOCTYPE HTML>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Sandglass – Admin Login</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link rel="shortcut icon" type="image/x-icon" href="/admin/assets/imgs/theme/favicon.svg">
    <link href="/admin/assets/css/main.css" rel="stylesheet" type="text/css" />
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --purple-50: #EEEDFE;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --red-50: #FCEBEB;
            --red-600: #A32D2D;
            --bg-primary: #ffffff;
            --bg-secondary: #f8f7fc;
            --bg-tertiary: #f2f0f9;
            --text-primary: #1a1825;
            --text-secondary: #6b6880;
            --text-tertiary: #9b98ab;
            --border: rgba(83, 74, 183, 0.12);
            --border-md: rgba(83, 74, 183, 0.2);
            --radius-md: 8px;
            --radius-lg: 12px;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--bg-tertiary);
            color: var(--text-primary);
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Topbar ── */
        .topbar {
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            background: var(--purple-600);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .brand-sub {
            font-size: 11px;
            color: var(--text-tertiary);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            background: var(--bg-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }

        .icon-btn:hover {
            background: var(--bg-secondary);
        }

        .icon-btn i {
            font-size: 17px;
            color: var(--text-secondary);
        }

        /* ── Center ── */
        .center {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        /* ── Login card ── */
        .login-card {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 2rem;
            width: 100%;
            max-width: 400px;
        }

        .card-head {
            margin-bottom: 1.5rem;
        }

        .card-icon {
            width: 44px;
            height: 44px;
            background: var(--purple-50);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }

        .card-icon i {
            font-size: 22px;
            color: var(--purple-600);
        }

        .card-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .card-sub {
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* Alert */
        .alert {
            background: var(--red-50);
            border: 1px solid rgba(163, 45, 45, 0.2);
            border-radius: var(--radius-md);
            padding: 10px 12px;
            font-size: 13px;
            color: var(--red-600);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert i {
            font-size: 16px;
            flex-shrink: 0;
        }

        /* Form */
        .form-group {
            margin-bottom: 1rem;
        }

        .form-label {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 5px;
            display: block;
        }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 8px 12px;
            transition: border-color .15s, background .15s;
        }

        .input-wrap:focus-within {
            border-color: var(--purple-400);
            background: var(--bg-primary);
        }

        .input-wrap i {
            font-size: 16px;
            color: var(--text-tertiary);
            flex-shrink: 0;
        }

        .input-wrap input {
            background: none;
            border: none;
            outline: none;
            font-size: 13px;
            color: var(--text-primary);
            width: 100%;
        }

        .input-wrap input::placeholder {
            color: var(--text-tertiary);
        }

        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-secondary);
            cursor: pointer;
        }

        .remember input[type=checkbox] {
            accent-color: var(--purple-600);
            width: 14px;
            height: 14px;
        }

        .forgot {
            font-size: 13px;
            color: var(--purple-600);
            text-decoration: none;
        }

        .forgot:hover {
            text-decoration: underline;
        }

        .btn-submit {
            width: 100%;
            padding: 9px;
            border-radius: var(--radius-md);
            background: var(--purple-600);
            color: #fff;
            border: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .btn-submit:hover {
            background: var(--purple-800);
        }

        .btn-submit i {
            font-size: 16px;
        }

        /* ── Footer ── */
        footer {
            padding: 1rem 1.5rem;
            font-size: 12px;
            color: var(--text-tertiary);
            border-top: 1px solid var(--border);
            background: var(--bg-primary);
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- ── Topbar ── -->
    <header class="topbar">
        <a href="/admin/dashboard" class="brand">
            <div class="brand-icon">
                <img src="/admin/assets/imgs/theme/sandglass-high-resolution-logo-transparent.svg"
                    style="width:22px;height:22px;object-fit:contain;filter:brightness(0) invert(1)" alt="Sandglass">
            </div>
            <div>
                <div class="brand-name">Sandglass</div>
                <div class="brand-sub">Admin panel</div>
            </div>
        </a>
        <div class="topbar-right">
            <a href="#" class="icon-btn darkmode" title="Dark mode"><i class="ti ti-moon"></i></a>
            <a href="#" class="requestfullscreen icon-btn" title="Fullscreen"><i class="ti ti-maximize"></i></a>
        </div>
    </header>

    <!-- ── Center ── -->
    <div class="center">
        <div class="login-card">

            <div class="card-head">
                <div class="card-icon"><i class="ti ti-lock"></i></div>
                <div class="card-title">Sign in</div>
                <div class="card-sub">Access your store admin panel</div>
            </div>

            <% if(locals.message) { %>
                <div class="alert">
                    <i class="ti ti-alert-circle"></i>
                    <%= message %>
                </div>
                <% } %>

                    <form method="post">
                        <div class="form-group">
                            <label class="form-label">Admin ID</label>
                            <div class="input-wrap">
                                <i class="ti ti-user"></i>
                                <input type="text" id="adminId" name="adminId" placeholder="Enter your admin ID" value="Admin">
                            </div>
                            <span style="color:var(--red-600); font-size:12px; display:block; margin-top:4px;"
                                id="adminIdError"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <div class="input-wrap">
                                <i class="ti ti-lock"></i>
                                <input type="password" id="adminPassword" name="adminPassword"
                                    placeholder="Enter your password" value="Admin@123">
                            </div>
                            <span style="color:var(--red-600); font-size:12px; display:block; margin-top:4px;"
                                id="adminPasswordError"></span>
                        </div>


                        <div class="form-footer">
                            <label class="remember">
                                <input type="checkbox" checked> Remember me
                            </label>
                            <a href="#" class="forgot">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="ti ti-login"></i> Login
                        </button>
                    </form>

        </div>
    </div>

    <!-- ── Footer ── -->
    <footer>
        <script>document.write(new Date().getFullYear())</script> &copy; Sandglass &mdash; All rights reserved
    </footer>

    <script>
        document.getElementById('adminLoginForm').addEventListener('submit', function (event) {
            let valid = true;

            document.getElementById('adminIdError').textContent = '';
            document.getElementById('adminPasswordError').textContent = '';

            const adminId = document.getElementById('adminId');
            if (!adminId.value.trim()) {
                document.getElementById('adminIdError').textContent = 'Admin ID is required.';
                valid = false;
            }

            const adminPassword = document.getElementById('adminPassword');
            if (!adminPassword.value) {
                document.getElementById('adminPasswordError').textContent = 'Password is required.';
                valid = false;
            }

            if (!valid) {
                event.preventDefault();
            }
        });
    </script>

    <script src="/admin/assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="/admin/assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="/admin/assets/js/vendors/jquery.fullscreen.min.js"></script>
    <script src="/admin/assets/js/main.js" type="text/javascript"></script>

</body>

</html>
