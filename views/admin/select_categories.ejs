<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Sandglass – Add Categories to Offer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link rel="shortcut icon" type="image/x-icon" href="/admin/assets/imgs/theme/favicon.svg">
    <link href="/admin/assets/css/main.css" rel="stylesheet" type="text/css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --purple-50: #EEEDFE;
            --purple-200: #AFA9EC;
            --purple-400: #7F77DD;
            --purple-600: #534AB7;
            --purple-800: #3C3489;
            --red-50: #FCEBEB;
            --red-600: #A32D2D;
            --bg-primary: #ffffff;
            --bg-secondary: #f8f7fc;
            --bg-tertiary: #f2f0f9;
            --text-primary: #1a1825;
            --text-secondary: #6b6880;
            --text-tertiary: #9b98ab;
            --border: rgba(83,74,183,0.12);
            --border-md: rgba(83,74,183,0.2);
            --radius-md: 8px;
            --radius-lg: 12px;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--bg-tertiary);
            color: var(--text-primary);
            font-size: 14px;
            line-height: 1.6;
        }

        .shell {
            display: grid;
            grid-template-columns: 230px 1fr;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .sidebar {
            background: var(--bg-primary);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .brand {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 34px; height: 34px;
            background: var(--purple-600);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
        }

        .brand-name { font-size: 15px; font-weight: 600; color: var(--text-primary); }
        .brand-sub  { font-size: 11px; color: var(--text-tertiary); }

        nav { padding: 1rem 0.75rem; flex: 1; overflow-y: auto; }

        .nav-label {
            font-size: 10px; letter-spacing: .08em;
            color: var(--text-tertiary);
            padding: 0 0.5rem; margin: 1rem 0 0.35rem;
            text-transform: uppercase; font-weight: 500;
        }

        .nav-item {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 10px; border-radius: var(--radius-md);
            font-size: 13.5px; color: var(--text-secondary);
            margin-bottom: 1px;
            transition: background .15s, color .15s;
            text-decoration: none;
        }

        .nav-item:hover  { background: var(--bg-secondary); color: var(--text-primary); }
        .nav-item.active { background: var(--purple-50); color: var(--purple-600); font-weight: 500; }
        .nav-item i { font-size: 17px; }
        .nav-item.active i { color: var(--purple-600); }

        .sidebar-footer { padding: 1rem 1.25rem; border-top: 1px solid var(--border); }

        .user-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }

        .avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--purple-50);
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 600; color: var(--purple-600); flex-shrink: 0;
        }

        .user-name { font-size: 13px; font-weight: 500; }
        .user-role { font-size: 11px; color: var(--text-tertiary); }

        .logout-btn {
            display: flex; align-items: center; gap: 8px;
            font-size: 13px; color: var(--text-secondary);
            padding: 7px 10px; border-radius: var(--radius-md);
            transition: background .15s; text-decoration: none;
        }
        .logout-btn:hover { background: var(--bg-secondary); }

        /* ── Main ── */
        .main { display: flex; flex-direction: column; }

        .topbar {
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 10;
        }

        .search {
            display: flex; align-items: center; gap: 8px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 6px 12px; width: 260px;
        }

        .search input {
            background: none; border: none; outline: none;
            font-size: 13px; color: var(--text-primary); width: 100%;
        }

        .search input::placeholder { color: var(--text-tertiary); }
        .search i { font-size: 16px; color: var(--text-tertiary); }

        .topbar-right { display: flex; align-items: center; gap: 8px; }

        .icon-btn {
            width: 34px; height: 34px; border-radius: var(--radius-md);
            border: 1px solid var(--border); background: var(--bg-primary);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: background .15s; text-decoration: none;
        }

        .icon-btn:hover { background: var(--bg-secondary); }
        .icon-btn i { font-size: 17px; color: var(--text-secondary); }

        /* ── Content ── */
        .content { padding: 1.5rem; flex: 1; }

        .page-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 1.5rem; gap: 12px; flex-wrap: wrap;
        }

        .page-title { font-size: 20px; font-weight: 600; }
        .page-sub   { font-size: 13px; color: var(--text-secondary); margin-top: 2px; }

        .back-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 7px 14px; border-radius: var(--radius-md);
            font-size: 13px; font-weight: 500;
            background: var(--bg-secondary); color: var(--text-secondary);
            border: 1px solid var(--border-md); text-decoration: none;
            transition: background .15s;
        }
        .back-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        .back-btn i { font-size: 15px; }

        /* ── Categories card ── */
        .categories-card {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
        }

        /* ── Category grid ── */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }

        .category-item {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            transition: border-color .15s, box-shadow .15s;
        }

        .category-item:hover {
            border-color: var(--purple-200);
            box-shadow: 0 2px 12px rgba(83,74,183,0.08);
        }

        .category-item.has-offer {
            border-color: var(--purple-200);
            background: var(--purple-50);
        }

        .category-icon {
            width: 38px; height: 38px;
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            display: flex; align-items: center; justify-content: center;
        }

        .category-icon i { font-size: 18px; color: var(--purple-400); }
        .category-item.has-offer .category-icon { background: var(--purple-600); border-color: var(--purple-600); }
        .category-item.has-offer .category-icon i { color: #fff; }

        .category-name {
            font-size: 13.5px; font-weight: 500;
            color: var(--text-primary);
            flex: 1;
        }

        /* Toggle buttons */
        .add-offer-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            width: 100%; padding: 7px 12px;
            border-radius: var(--radius-md);
            font-size: 12px; font-weight: 500;
            border: none; cursor: pointer;
            transition: all .15s;
        }
        .add-offer-btn i { font-size: 14px; }

        .add-offer-btn.state-add {
            background: var(--purple-50);
            color: var(--purple-600);
            border: 1px solid var(--purple-200);
        }
        .add-offer-btn.state-add:hover { background: var(--purple-200); }

        .add-offer-btn.state-remove {
            background: var(--red-50);
            color: var(--red-600);
            border: 1px solid rgba(163,45,45,0.2);
        }
        .add-offer-btn.state-remove:hover { background: #f5d5d5; }

        /* Empty state */
        .empty-state {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 4rem 2rem; gap: 12px;
            color: var(--text-tertiary);
        }
        .empty-state i { font-size: 48px; color: var(--purple-200); }
        .empty-state h3 { font-size: 18px; font-weight: 600; color: var(--text-secondary); }
        .empty-state p  { font-size: 13px; }

        footer {
            padding: 1rem 1.5rem;
            font-size: 12px; color: var(--text-tertiary);
            border-top: 1px solid var(--border);
            background: var(--bg-primary);
        }
    </style>
</head>
<body>

<div class="shell">

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">
                <img src="/admin/assets/imgs/theme/sandglass-high-resolution-logo-transparent.svg"
                     style="width:22px;height:22px;object-fit:contain;filter:brightness(0) invert(1)" alt="Sandglass">
            </div>
            <div>
                <div class="brand-name">Sandglass</div>
                <div class="brand-sub">Admin panel</div>
            </div>
        </div>

        <nav>
            <div class="nav-label">Main</div>
            <a href="/admin/dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
            <a href="/admin/products"  class="nav-item"><i class="ti ti-shopping-bag"></i> Products</a>
            <a href="/admin/orders"    class="nav-item"><i class="ti ti-shopping-cart"></i> Orders</a>
            <a href="/admin/users"     class="nav-item"><i class="ti ti-users"></i> Users</a>

            <div class="nav-label">Catalog</div>
            <a href="/admin/add_product" class="nav-item"><i class="ti ti-circle-plus"></i> Add product</a>
            <a href="/admin/categories"  class="nav-item"><i class="ti ti-apps"></i> Categories</a>
            <a href="/admin/coupons"     class="nav-item"><i class="ti ti-ticket"></i> Coupons</a>

            <div class="nav-label">Analytics</div>
            <a href="/admin/offers"     class="nav-item active"><i class="ti ti-tag"></i> Offers</a>
            <a href="/admin/statistics" class="nav-item"><i class="ti ti-chart-pie"></i> Statistics</a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-row">
                <div class="avatar">AD</div>
                <div>
                    <div class="user-name">Admin</div>
                    <div class="user-role">Store manager</div>
                </div>
            </div>
            <a href="/admin/logout" class="logout-btn"><i class="ti ti-logout"></i> Sign out</a>
        </div>
    </aside>

    <!-- ── Main ── -->
    <div class="main">

        <header class="topbar">
            <div class="search">
                <i class="ti ti-search"></i>
                <input type="text" placeholder="Search products, orders…">
            </div>
            <div class="topbar-right">
                <a href="#" class="icon-btn darkmode" title="Dark mode"><i class="ti ti-moon"></i></a>
                <a href="#" class="icon-btn requestfullscreen" title="Fullscreen"><i class="ti ti-maximize"></i></a>
                <a href="/admin/logout" class="icon-btn" title="Logout"><i class="ti ti-logout"></i></a>
            </div>
        </header>

        <div class="content">

            <div class="page-header">
                <div>
                    <div class="page-title">Add Categories to Offer</div>
                    <div class="page-sub">Select which categories this offer applies to</div>
                </div>
                <a href="/admin/offers" class="back-btn">
                    <i class="ti ti-arrow-left"></i> Back to Offers
                </a>
            </div>

            <input type="hidden" id="offerId" value="<%= offerId %>">

            <div class="categories-card">
                <% if (categories && categories.length > 0) { %>
                <div class="category-grid">
                    <% categories.forEach(category => { %>
                    <%
                        const hasOffer = offer.category.includes(category._id);
                        const action   = hasOffer ? 'remove' : 'add';
                    %>
                    <div class="category-item <%= hasOffer ? 'has-offer' : '' %>" id="card-<%= category._id %>">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="category-icon">
                                <i class="ti ti-apps"></i>
                            </div>
                            <div class="category-name"><%= category.name %></div>
                        </div>
                        <button
                            class="add-offer-btn <%= hasOffer ? 'state-remove' : 'state-add' %>"
                            onclick="toggleCategoryOffer('<%= category._id %>', '<%= action %>')">
                            <% if (hasOffer) { %>
                                <i class="ti ti-x"></i> Remove Offer
                            <% } else { %>
                                <i class="ti ti-plus"></i> Add Offer
                            <% } %>
                        </button>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="ti ti-apps-off"></i>
                    <h3>No categories found</h3>
                    <p>Create some categories first before assigning offers.</p>
                </div>
                <% } %>
            </div>

        </div>

        <footer>
            <script>document.write(new Date().getFullYear())</script> &copy; Sandglass &mdash; All rights reserved
        </footer>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/admin/assets/js/vendors/jquery-3.6.0.min.js"></script>
<script src="/admin/assets/js/vendors/bootstrap.bundle.min.js"></script>
<script src="/admin/assets/js/vendors/select2.min.js"></script>
<script src="/admin/assets/js/vendors/perfect-scrollbar.js"></script>
<script src="/admin/assets/js/vendors/jquery.fullscreen.min.js"></script>
<script src="/admin/assets/js/main.js" type="text/javascript"></script>

<script>
    async function toggleCategoryOffer(categoryId, action) {
        const offerId = document.getElementById('offerId').value;
        const url = action === 'add' ? '/admin/add_offer_category' : '/admin/remove_offer_category';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ offerId, categoryId })
            });

            const result = await response.json();

            if (response.ok) {
                const card   = document.getElementById(`card-${categoryId}`);
                const button = card.querySelector('.add-offer-btn');
                const icon   = card.querySelector('.category-icon');

                if (action === 'add') {
                    card.classList.add('has-offer');
                    icon.style.background    = 'var(--purple-600)';
                    icon.style.borderColor   = 'var(--purple-600)';
                    icon.querySelector('i').style.color = '#fff';
                    button.className = 'add-offer-btn state-remove';
                    button.innerHTML = '<i class="ti ti-x"></i> Remove Offer';
                    button.setAttribute('onclick', `toggleCategoryOffer('${categoryId}', 'remove')`);
                } else {
                    card.classList.remove('has-offer');
                    icon.style.background    = '';
                    icon.style.borderColor   = '';
                    icon.querySelector('i').style.color = '';
                    button.className = 'add-offer-btn state-add';
                    button.innerHTML = '<i class="ti ti-plus"></i> Add Offer';
                    button.setAttribute('onclick', `toggleCategoryOffer('${categoryId}', 'add')`);
                }
            } else {
                Swal.fire({ title: 'Error', text: result.error || 'An error occurred.', icon: 'error' });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({ title: 'Error', text: 'Failed to update offer. Please try again.', icon: 'error' });
        }
    }
</script>

</body>
</html>